#!/usr/bin/env bash
# crew — docs-kit execution-layer CLI (EXECUTION.md is the contract this file
# implements; stamped into the target repo as scripts/crew by /docs-kit:crew-init).
#
# The merge procedure lives HERE as a command, not as prose, because a procedure
# kept as prose gets re-typed from memory and the two middle checks are the first
# thing to fall out (EXECUTION §6). Do not "simplify" the checks away.
#
# Portability floor: bash 3.2, BSD awk/grep/sed, python3 only for reading
# .docs-kit.json (degrades to defaults without it). No Node, no jq.
#
# Subcommands:
#   crew new <nnn> [--chain]             ticket → a free executor (grows the pool if none);
#                                        --chain: this session carries the chain from here
#   crew done <nnn> [--park]             merge, close-out, then the chain's next ticket or park
#   crew executor add|rm <k>|prune       the persistent worktree pool
#   crew lock acquire <res> <nnn> [--wait]
#   crew lock release <res> <nnn>
#   crew status                          executors · locks · pacing signals
#   crew report [<period>] [--write]     the week's numbers for the navigator's report
#   crew name <role> [<nnn>|<subject>]   is this session wearing its name?
#     [--want]                           print the title it should wear, nothing else
#     [--group]                          the sidebar groups it belongs in, best first
#   crew role <role>                     print a role file (works from a worktree)
set -u

die()  { echo "crew: $*" >&2; exit 1; }
note() { echo "crew: $*"; }

# ---------------------------------------------------------------- resolution
# Main tree = first entry of `git worktree list` (documented git behaviour).
# Shared state = sibling of the main tree — outside every checkout, so every
# session sees one set of locks (EXECUTION §4). Computed, never guessed: this
# exact resolution is what makes the CLI work identically from any -e worktree.
MAIN="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}')"
[ -n "$MAIN" ] || die "not inside a git repository"
REPO="$(basename "$MAIN")"
STATE="$(dirname "$MAIN")/${REPO}-crew"
CONF="$MAIN/.docs-kit.json"

# ---------------------------------------------------------------- config
# cfg <key> <default> — reads .docs-kit.json .crew.<key>. Lists print
# space-joined. Any parse trouble → the default (fail open, like the hooks).
cfg() {
  if [ -f "$CONF" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "$1" "$2" "$CONF" 2>/dev/null <<'PY' || echo "$2"
import json, sys
key, dflt, path = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    crew = (json.load(open(path)) or {}).get("crew")
except Exception:
    print(dflt); raise SystemExit
if not isinstance(crew, dict):
    print(dflt); raise SystemExit
v = crew.get(key, dflt)
if isinstance(v, list):
    print(" ".join(str(x) for x in v))
else:
    print(v)
PY
  else
    echo "$2"
  fi
}

crew_on() {
  [ -f "$CONF" ] || return 1
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$CONF" 2>/dev/null <<'PY'
import json, sys
try:
    ok = isinstance((json.load(open(sys.argv[1])) or {}).get("crew"), dict)
except Exception:
    ok = False
sys.exit(0 if ok else 1)
PY
  else
    grep -q '"crew"' "$CONF"
  fi
}

require_on() {
  crew_on || die "the crew layer is off in this repo — run /docs-kit:crew-init first (EXECUTION §9)"
}

# ---------------------------------------------------------------- helpers
# norm 42 | 157 | BACKLOG-157 → zero-padded number, same digits as the id.
norm() {
  n="${1#BACKLOG-}"
  case "$n" in ''|*[!0-9]*) die "bad ticket number: $1" ;; esac
  printf '%03d' "$((10#$n))"
}

ticket_file() { # ticket_file <nnn> → path of the Backlog doc, or empty
  grep -rlE "^id:[[:space:]]*\"?BACKLOG-$1\"?" "$MAIN/docs/23_backlog" 2>/dev/null | head -1
}

front() { # front <file> <key> → frontmatter value, quotes and inline comment stripped
  awk -F': ' -v k="$2" '$1==k {v=$2; sub(/[ \t]*#.*$/,"",v); gsub(/"/,"",v); gsub(/^[ \t]+|[ \t]+$/,"",v); print v; exit}' "$1"
}

log_line() { # log_line <event> <resource> <ticket> <detail>
  mkdir -p "$STATE"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1" "$2" "$3" "$4" >> "$STATE/log.tsv"
}

# ---------------------------------------------------------------- executors
# The pool is persistent: `<parent>/<repo>-e<k>` trees are created once and kept
# across tickets. The ticket↔executor pin is NOT a registry file — it is the
# branch each tree has checked out, which git already stores and cannot let
# drift. Git also refuses to check out one branch in two worktrees, so "free"
# is encoded as a detached HEAD at the dev branch, not as sitting on it.
exec_map() { # → "<path>\t<branch or -->" per executor tree, one line each
  git -C "$MAIN" worktree list --porcelain | awk -v r="$REPO" '
    function flush() { if (p != "") { n = p; sub(/.*\//, "", n); if (n ~ pat) print p "\t" b } }
    BEGIN { gsub(/\./, "\\.", r); pat = "^" r "-e[0-9]+$" }
    /^worktree /{ flush(); p = substr($0, 10); b = "-" }
    /^branch /  { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    END { flush() }'
}
# FREE IS NOT THE SAME AS DETACHED. Measured 2026-09-09: an executor parked by
# hand — which is exactly what `crew done` tells the operator to do when its own
# park refuses — still carried the finished ticket's uncommitted file. It read
# `idle`, `crew new` handed it to the next ticket, and `git switch -c` carried
# that file onto the new branch, where the next `git add -A` sweeps one ticket's
# work into another ticket's commit. So a tree is free when it holds no branch
# AND owns nothing uncommitted. A tree that fails the second half drops out of
# the pool and `crew new` grows instead, which is already the designed answer to
# "nothing is free" — never a silent handover of somebody's work.
exec_free() {
  exec_map | awk -F'\t' '$2 == "-" { print $1 }' | while IFS= read -r p; do
    [ "$(own_dirty "$p")" -eq 0 ] && { echo "$p"; break; }
  done
}

# Claiming an executor must be ATOMIC. Measured 2026-09-08 with three concurrent
# `crew new` against a pool of two: all three read the same free tree, the last
# `git switch` won, and in 4 runs out of 5 only ONE ticket landed while the
# second executor sat idle and a branch was left held by nobody — a command that
# had already printed success had its tree taken. `mkdir` is the atomic
# test-and-set available on the portability floor; the wait is bounded so a
# crashed claim cannot wedge the repo silently.
claim_lock() {
  mkdir -p "$STATE"
  CL="$STATE/assign.lock"
  i=0
  while ! mkdir "$CL" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge 15 ] && die "another crew new has held the claim for 15s — if none is running, remove $CL"
    sleep 1
  done
  trap 'rmdir "$STATE/assign.lock" 2>/dev/null || true' EXIT INT TERM
}
claim_unlock() {
  trap - EXIT INT TERM
  rmdir "$STATE/assign.lock" 2>/dev/null || true
}
# Count only what the TICKET left behind. The provisioned payload is crew's own,
# and some of it cannot be gitignored at all — a `dir/` rule does not match a
# symlink — so counting it would make a freshly built executor look like it had
# already started work, and `preparing` would be unreachable in such a repo.
own_files() {
  git -C "$1" status --porcelain 2>/dev/null | awk '{print $NF}' | while IFS= read -r q; do
    [ -n "$q" ] || continue
    q="${q%/}"
    for c in $(cfg copy "node_modules") $(cfg link "") briefs; do
      case "$q" in "$c"|"$c"/*) continue 2 ;; esac
    done
    echo "$q"
  done
}
own_dirty() { own_files "$1" | wc -l | tr -d ' '; }
exec_on()   { exec_map | awk -F'\t' -v b="$1" '$2 == b { print $1; exit }'; }
en()        { n="$(basename "$1")"; echo "${n##*-}"; }   # …/myapp-e2 → e2

# has_closer <dir> <nnn> <log-args...> — does any commit in that range close the
# ticket? `grep -c` and not `grep -q`: a -q that matches early SIGPIPEs the git
# it is reading from, which is a live hazard under pipefail.
has_closer() {
  HC_D="$1"; HC_N="$2"; shift 2
  HC_C="$(git -C "$HC_D" log "$@" --format=%B 2>/dev/null | grep -c "^Closes: BACKLOG-$HC_N" || true)"
  [ "${HC_C:-0}" -gt 0 ]
}

# ticket_done <nnn> → true when the Backlog doc reads `status: done`. The merge
# is only half of a close-out: STANDARD §6.1 wants the status flipped and an
# audit line citing a sha, and `crew done` writes that half through docs_close
# AFTER the merge — a step skipped on every machine where docs_close cannot be
# reached (ISSUE-014). The two halves are therefore read separately, so the
# state can say which one is still missing. A missing file or a missing key
# reads false: a repo without the docs layer must never have work reported as
# closed on the strength of a guess.
ticket_done() {
  TD_F="$(ticket_file "$1")"
  [ -n "$TD_F" ] || return 1
  [ "$(front "$TD_F" status)" = "done" ]
}

# closed_state <nnn> → finishing | finished, for a ticket whose closer is ALREADY
# on the dev branch. ONE place, because the executor path and the fast-pair path
# ask that same question and must never answer it two different ways.
closed_state() { if ticket_done "$1"; then echo finished; else echo finishing; fi; }

# ---------------------------------------------------------------- chains
# A chain is tickets that cannot run side by side because each one edits what the
# one before it built. The planner records the order on the LATER ticket, as
# `after_ref: BACKLOG-<nnn>` — the edge sits on the thing that has the dependency,
# the same direction as every other *_ref, so the validator's ref check already
# resolves it and nothing here re-checks that.
#
# WHY A FIELD AND NOT A FLAG ON `crew new`: measured on the repo that filed the
# gap (330 backlog items, 6 executors, two lanes of 5 and 3), the order of a chain
# was a fact that lived only in a chat message between two sessions. A flag would
# have moved it into ../<repo>-crew/, which is never committed and is written by
# the executor, not the planner.
#
# WHO CARRIES the chain is the opposite kind of fact, so it IS a flag: it belongs
# to a session, not to the tickets. Measured 2026-09-24 with three real executor
# sessions on one chain, before 0.41.2: the session given the ordinary one-ticket
# prompt for the first ticket stopped after its `crew done` — rightly, its prompt
# put the next ticket out of scope — while crew done, reading only after_ref, had
# already handed it the next branch. The tree sat on that branch with nobody in
# it, and the board read exactly like a live session. So a session takes the
# chain once, `crew new <nnn> --chain`, which is logged on its NEW line (see
# carried), and crew done hands a tree on only for a session that did.
#
# One predecessor per ticket, so a chain is a line and a fork is a tree. Where a
# ticket has several successors, "next" is the lowest-numbered one not done yet;
# the title, the board and `crew done` all use that one rule. Every walk keeps a
# visited set, so an after_ref loop ends the walk instead of the command.
chain_rows() { # → "<nnn>\t<after nnn or ->\t<status>\t<execution or ->" per Backlog doc
  [ -d "$MAIN/docs/23_backlog" ] || return 0
  find "$MAIN/docs/23_backlog" -type f -name '*.md' -exec awk '
    function val(s) { sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t]*#.*$/, "", s); gsub(/"/, "", s); gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function num(s) { return sprintf("%03d", substr(s, 9) + 0) }
    function flush() {
      if (id ~ /^BACKLOG-[0-9]+$/)
        print num(id) "\t" (af ~ /^BACKLOG-[0-9]+$/ ? num(af) : "-") "\t" (st == "" ? "-" : st) "\t" (ex == "" ? "-" : ex)
    }
    FNR == 1 { if (NR > 1) flush(); id = af = st = ex = ""; fm = 0; if (/^---/) { fm = 1; next } }
    fm && /^---/        { fm = 0; next }
    fm && /^id:/        { id = val($0) }
    fm && /^after_ref:/ { af = val($0) }
    fm && /^status:/    { st = val($0) }
    fm && /^execution:/ { ex = val($0) }
    END { if (NR > 0) flush() }' {} + 2>/dev/null
}

# chain_awk span <nnn>  → "<first>→<last>", or nothing for a ticket in no chain
# chain_awk next <nnn>  → "<nnn>\t<execution>\t<other open successors>", or nothing
# chain_awk board "<nnn>=<place> …" [<nnn>] → the `chains:` rows of crew status, or
#   only the row of the chain holding <nnn>; a place ending in ~ is a session that
#   holds that ticket without carrying its chain (chain_holders)
# A function below is never handed an array element itself, only a copy
# (`succ[k] ""`): gawk 5.2.1, the awk on GitHub's ubuntu-latest, dies with
# "unexpected parameter type Node_illegal" when it is handed an element that was
# only ever read, which is what succ[k] is for the last ticket of a chain.
CHAIN_AWK='
function low(list,   a, i, n, b) {
  n = split(list, a, " "); b = ""
  for (i = 1; i <= n; i++) if (b == "" || a[i] + 0 < b + 0) b = a[i]
  return b
}
function up(k) { return (k in aft) && aft[k] != "-" && (aft[k] in st) }
function first(t,   f, seen) {
  f = t; seen[f] = 1
  while (up(f) && !(aft[f] in seen)) { f = aft[f]; seen[f] = 1 }
  return f
}
function last(t,   l, n, seen) {
  l = t; seen[l] = 1
  while (succ[l] != "") { n = low(succ[l] ""); if (n in seen) break; l = n; seen[l] = 1 }
  return l
}
function sorted(list, out,   n, i, j, v) {
  n = split(list, out, " ")
  for (i = 2; i <= n; i++) { v = out[i]; j = i - 1; while (j > 0 && out[j] + 0 > v + 0) { out[j + 1] = out[j]; j-- } out[j + 1] = v }
  return n
}
function openafter(k,   a, i, n) {
  n = split(succ[k], a, " ")
  for (i = 1; i <= n; i++) if (st[a[i]] != "done") return 1
  return 0
}
{ aft[$1] = $2; st[$1] = $3; ex[$1] = $4 }
END {
  for (k in aft) if (up(k)) succ[aft[k]] = succ[aft[k]] " " k
  if (mode == "span") {
    if (!(arg in st)) exit
    f = first(arg); l = last(arg)
    if (up(f)) exit   # the walk back stopped on a loop, not on a first ticket
    if (f != arg || l != arg) print f "→" l
    exit
  }
  if (mode == "next") {
    n = ""; o = ""
    m = sorted(succ[arg] "", s)
    for (i = 1; i <= m; i++) if (st[s[i]] != "done") { if (n == "") n = s[i]; else o = o " " s[i] }
    if (n != "") print n "\t" ex[n] "\t" substr(o, 2)
    exit
  }
  m = split(arg, hl, " ")
  for (i = 1; i <= m; i++) {
    p = index(hl[i], "="); if (!p) continue
    k = substr(hl[i], 1, p - 1); v = substr(hl[i], p + 1)
    if (v ~ /~$/) { v = substr(v, 1, length(v) - 1); solo[k] = 1 }
    hp[k] = v
  }
  rl = ""
  for (k in st) if (succ[k] != "" && !up(k)) rl = rl " " k
  nr = sorted(rl, roots)
  if (only != "") { if (!(only in st)) exit; only = first(only) }
  for (r = 1; r <= nr; r++) {
    if (only != "" && roots[r] != only) continue
    top = 0; stk[++top] = roots[r]; seq = ""
    while (top > 0) {
      k = stk[top--]
      if (k in vis) continue
      vis[k] = 1; seq = seq " " k
      c = sorted(succ[k] "", kids)
      for (i = c; i >= 1; i--) stk[++top] = kids[i]
    }
    n = split(seq, mem, " "); land = ""; queue = ""; ready = ""; nc = 0; fk = ""
    for (i = 1; i <= n; i++) {
      k = mem[i]
      if (st[k] == "done") land = land " " k
      else if (k in hp) held[++nc] = hp[k] " on " k ((k in solo) && openafter(k) ? " (this ticket only)" : "")
      else { queue = queue " " k; if (ready == "" && (!up(k) || st[aft[k]] == "done")) ready = k }
      if (split(succ[k], tmp, " ") > 1) fk = fk " " k
    }
    if (queue == "" && nc == 0) continue
    line = "  " roots[r] "→" last(roots[r] "") " "
    sep = " "
    if (land != "") { line = line sep "landed" land; sep = " · " }
    for (i = 1; i <= nc; i++) { line = line sep held[i]; sep = " · " }
    if (queue != "") line = line sep "queued" queue
    if (nc == 0 && ready != "") line = line "  ← no session carries this chain — next: scripts/crew new " ready (openafter(ready) ? " --chain" : "")
    print line
    if (only != "") exit
    q = split(fk, fks, " ")
    for (i = 1; i <= q; i++) {
      c = sorted(succ[fks[i]] "", kids); fl = ""; nx = ""
      for (j = 1; j <= c; j++) { fl = fl " " kids[j]; if (nx == "" && st[kids[j]] != "done") nx = kids[j] }
      if (nx != "") print "    fork: " fks[i] " is followed by" fl " — a session carrying the chain goes on from " fks[i] " into " nx "; every other one needs a session of its own"
    }
  }
  if (only != "") exit
  cy = ""
  for (k in st) if (up(k) && !(k in vis)) cy = cy " " k
  c = sorted(cy, cys); cy = ""
  for (i = 1; i <= c; i++) cy = cy " " cys[i]
  if (cy != "") print "  note: after_ref loops back on itself through" cy " — no ticket in it can ever be first"
}'
chain_awk() { chain_rows | awk -F'\t' -v mode="$1" -v arg="${2:-}" -v only="${3:-}" "$CHAIN_AWK"; }

# chain_seg <nnn> → "<first>→<last> · " for a ticket in a chain, nothing otherwise,
# so a ticket nobody chained keeps exactly the title it had before chains existed.
chain_seg() {
  CS="$(chain_awk span "$1")"
  [ -z "$CS" ] || printf '%s · ' "$CS"
}

# ---------------------------------------------------------------- subjects
# A ticket serves the layer-2 document its `source_ref` names: an Issue on the
# fast lane, a Decision on the full lane (STANDARD §5). That document is the
# ticket's SUBJECT, and titles carry it as a short token — `d009`, `i020` — so an
# executor and the planner working the same subject share one visible string.
#
# WHY THE SOURCE_REF AND NOT A NEW FIELD: measured 2026-09-24 on four repos, from
# `b<nnn>` alone the user could not tell which planner to go back to. The link
# was already in every ticket and already resolved by the validator; nothing
# showed it. A `planner:` field was considered and dropped: typed by hand, and it
# names a session, which ends, instead of the work, which does not.
#
# WHY NOT THE APP'S OWN PARENT LINK: every chip-born executor records the session
# that made its chip (40 of 40 measured). That names whoever made the chip, not
# who holds the context — with a coordinating planner making the chips, every
# executor points at the coordinator. It is also desktop-only, unreadable here.

# subj_id d009 | DECISION-009 | i20 | ISSUE-020 → DECISION-009, ISSUE-020; fails otherwise
subj_id() {
  case "$1" in
    [dD][0-9]*) SJT=DECISION; SJN="${1#?}" ;;
    [iI][0-9]*) SJT=ISSUE;    SJN="${1#?}" ;;
    [pP][0-9]*) SJT=PROPOSAL; SJN="${1#?}" ;;
    DECISION-*|ISSUE-*|PROPOSAL-*) SJT="${1%%-*}"; SJN="${1#*-}" ;;
    *) return 1 ;;
  esac
  case "$SJN" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s-%03d' "$SJT" "$((10#$SJN))"
}

# subj_tok DECISION-009 → d009, the same shape as b<nnn>
subj_tok() { printf '%s%s' "$(printf '%s' "$1" | cut -c1 | tr 'DIP' 'dip')" "${1#*-}"; }

# doc_file <ID> → the layer-2 doc whose frontmatter id is <ID>, archive included
doc_file() {
  grep -rlE "^id:[[:space:]]*\"?$1\"?[[:space:]]*(#.*)?\$" "$MAIN/docs" 2>/dev/null | head -1
}

# subj_label <ID> → "d009 co-vi-the-theo-von-hien-tai": the token, then the slug
# the doc's own file name carries, so the words are read, not typed. Fails when no
# document has that id: a subject is always something that exists.
subj_label() {
  DFP="$(doc_file "$1")"
  [ -n "$DFP" ] || return 1
  DFB="$(basename "$DFP" .md)"
  case "$DFB" in
    "$1"-?*) printf '%s %s' "$(subj_tok "$1")" "${DFB#"$1"-}" ;;
    *)       subj_tok "$1" ;;
  esac
}

# ticket_subject <nnn> → the ID its source_ref names, or nothing (fail open: a
# ticket with no readable source keeps the rest of its title)
ticket_subject() {
  TSF="$(ticket_file "$1")"
  [ -n "$TSF" ] || return 0
  subj_id "$(front "$TSF" source_ref)" || true
}

# subj_seg <nnn> → "d009 · ", or nothing — same shape as chain_seg
subj_seg() {
  SJ="$(ticket_subject "$1")"
  [ -z "$SJ" ] || printf '%s · ' "$(subj_tok "$SJ")"
}

# exec_title <nnn> <place> <state> → the executor session title. ONE place: crew
# name compares against it and crew new prints it, so the grammar is spelled once.
# The ticket leads the task part because a list that cuts a long title keeps its
# head: what goes first is what still reads when the rest is an ellipsis.
exec_title() {
  printf '%s · executor · b%s · %s%s%s · %s' "$REPO" "$1" "$(subj_seg "$1")" "$(chain_seg "$1")" "$2" "$3"
}

# carried <nnn> → true when the tree holding BACKLOG-<nnn> belongs to a session
# that carries the chain: its `crew new` said --chain, or it reached this ticket
# by a handoff from one that did. Read from the LAST NEW line for the ticket in
# log.tsv, so a ticket reopened later is judged by how it was reopened. A missing
# log reads false, and false is the safe side: crew done parks, and the board's
# arrow names the ticket that is ready.
carried() {
  [ -f "$STATE/log.tsv" ] || return 1
  awk -F'\t' -v t="BACKLOG-$1" '$2 == "NEW" && $4 == t { c = ($5 ~ / chain$/) } END { exit !c }' "$STATE/log.tsv"
}

# chain_holders → "<nnn>=<place> …" for every ticket a tree holds, with a ~ after
# the place when that session does not carry the chain. The board and crew done's
# progress line read holders from here, so they cannot name two different ones.
chain_holders() {
  exec_map | awk -F'\t' '$2 ~ /^work\/b[0-9]+$/ { n = $1; sub(/.*\//, "", n); sub(/.*-/, "", n); b = $2; sub(/^work\/b/, "", b); print b "\t" n }' \
    | while IFS=$'\t' read -r ch_b ch_n; do
        if carried "$ch_b"; then printf '%s=%s ' "$ch_b" "$ch_n"; else printf '%s=%s~ ' "$ch_b" "$ch_n"; fi
      done
  pair_tickets | awk 'NF { printf "%s=main ", $1 }'
}

# next_cmd <nnn> → the command that starts BACKLOG-<nnn>, with --chain when a
# ticket still runs after it: the one line the board, crew new and crew done
# print, so the planner copies the same thing whichever of them it read.
next_cmd() {
  if [ -n "$(chain_awk next "$1")" ]; then echo "scripts/crew new $1 --chain"; else echo "scripts/crew new $1"; fi
}

# carried_run <nnn> → the tickets this tree carried, oldest first, ending at <nnn>:
# each handoff's NEW line names the ticket it followed (after=), so the run is
# walked back from <nnn> until a NEW line that a `crew new` wrote.
carried_run() {
  [ -f "$STATE/log.tsv" ] || { echo "BACKLOG-$1"; return 0; }
  awk -F'\t' -v n="BACKLOG-$1" '
    $2 == "NEW" { d[$4] = $5 }
    END {
      t = n; seq = t; seen[t] = 1
      while ((t in d) && match(d[t], /after=BACKLOG-[0-9]+/)) {
        p = substr(d[t], RSTART + 6, RLENGTH - 6)
        if (p in seen) break
        seen[p] = 1; seq = p " " seq; t = p
      }
      print seq
    }' "$STATE/log.tsv"
}

# exec_state <tree> <branch> → processing | finishing | finished. Derived, never
# stored, and computed in ONE place so the board and the session title can never
# disagree. Only states something ACTS on get a word: `finishing` means the work
# declared itself done and the close-out is not complete (action: crew done),
# which is the 7h18 of unmerged work the origin repo measured (EXECUTION §5);
# `finished` means nothing is left on the ticket at all (action: close the
# session, park the tree). `finished` was added in 0.39.0 because without it a
# session whose work had already landed read exactly like one still waiting for
# its merge — which is the distinction `finishing` exists to make.
exec_state() {
  # A trailer on an EARLIER commit does not mean the work stopped. Measured
  # 2026-09-09: with the trailer written and one file still uncommitted, the
  # board printed `finishing dirty=1` — two columns contradicting each other —
  # and `crew done` then ran to completion: the ticket flipped to `status: done`
  # with an audit line citing a sha while that file never landed. The
  # uncommitted count is therefore part of the state, not a column beside it.
  # This test stays FIRST even after the merge: an uncommitted file in an
  # executor tree is the one thing that must never go invisible.
  if [ "$(own_dirty "$1")" -gt 0 ]; then echo processing; return; fi
  ES_N="${2##*/b}"
  ES_DEV="$(cfg dev_branch main)"
  # WHERE the closer sits is what decides, and the dev branch is asked FIRST.
  # Measured 2026-09-12, before this order existed: the only test was the range
  # `$DEV..$branch`, which a fast-forward merge empties — so the instant the
  # work landed, the board and the title both fell back from `finishing` to
  # `processing`, a word that reads "a session is on that ticket" for work
  # already sitting on the dev branch.
  # Stated ceiling, not papered over: the dev branch is read 50 commits deep, the
  # same window `pair_state` has always used. Step 5b of the hat runs right after
  # `crew done`, when the closer is the tip, so the window bites only a session
  # retitled 50+ commits later — and there the board's `orphan` flag is what
  # names the tree instead.
  # A closer on the dev branch counts only when this branch made it (own_landed).
  # Measured 2026-09-24: a session committed its ticket straight onto main in the
  # main tree, and from that second the row read `finishing` for a tree that had
  # no commit at all.
  if has_closer "$MAIN" "$ES_N" -50 "$ES_DEV" && own_landed "$ES_N"; then closed_state "$ES_N"; return; fi
  if has_closer "$1" "$ES_N" "$ES_DEV..$2"; then echo finishing; else echo processing; fi
}

# closer_split <nnn> → "own <sha>" or "bypass <sha>" for every commit carrying the
# ticket's closer on the dev branch or on work/b<nnn>. Own means it sits on the
# branch's first-parent line, so the branch itself made it; bypass means it
# reached the code some other way — measured twice on 2026-09-24, an executor
# session committing its ticket onto main in the MAIN tree, which skips check 0,
# the tests and checks 1–2, and which check 2 cannot see because nothing is left
# uncommitted.
# WHY FIRST-PARENT AND NOT A RANGE: `work/b<nnn>..<dev>` finds the stray commit
# only until crew done merges the dev branch into the branch. A run that then
# dies on a red test leaves it merged, and the rerun would read clean. On the
# first-parent line it stays a second parent for good, so crew done, the board
# and the title read the same answer before and after any merge.
# The id is matched whole: BACKLOG-1000's closer is not BACKLOG-100's.
closer_split() {
  CL_DEV="$(cfg dev_branch main)"
  git -C "$MAIN" rev-parse -q --verify "refs/heads/work/b$1" >/dev/null || return 0
  CL_OWN="
$(git -C "$MAIN" rev-list --first-parent -200 "work/b$1" 2>/dev/null)
"
  { git -C "$MAIN" log -E --format=%H --grep="^Closes: BACKLOG-$1([^0-9]|\$)" -50 "$CL_DEV" 2>/dev/null
    git -C "$MAIN" log -E --format=%H --grep="^Closes: BACKLOG-$1([^0-9]|\$)" -50 "work/b$1" 2>/dev/null
  } | sort -u | while IFS= read -r cl_h; do
    [ -n "$cl_h" ] || continue
    case "$CL_OWN" in
      *"
$cl_h
"*) echo "own $cl_h" ;;
      *)  echo "bypass $cl_h" ;;
    esac
  done
}
own_landed() { # own_landed <nnn> → true when a closer work/b<nnn> made is on the dev branch
  OL_DEV="$(cfg dev_branch main)"
  for ol_h in $(closer_split "$1" | awk '$1 == "own" { print $2 }'); do
    git -C "$MAIN" merge-base --is-ancestor "$ol_h" "$OL_DEV" 2>/dev/null && return 0
  done
  return 1
}
bypass_shas() { # bypass_shas <nnn> → the stray closers as short shas, comma-joined, or nothing
  for bs_h in $(closer_split "$1" | awk '$1 == "bypass" { print $2 }'); do
    git -C "$MAIN" rev-parse --short "$bs_h"
  done | paste -sd, -
}

# The same three states for a fast-pair session, which has no branch of its own:
# its trailer lands straight on the dev branch, so that is where to look. Note
# that `finished` is reachable here only from `crew name` — `pair_tickets` below
# lists in-progress tickets, so a closed one has already dropped off the board,
# which is correct: the row is about a tree still carrying work, the title is
# about a session still open.
# NOTE the asymmetry, and do not "fix" it into symmetry: the uncommitted-work
# rule above holds because an executor tree belongs to exactly ONE ticket, so
# anything uncommitted in it is that ticket's. The main tree is shared: other
# sessions' fast-pair edits sit there, and so does the close-out docs-sync writes
# for a fast-pair ticket, which it never commits (crew done commits its own since
# 0.41.1). Reading dirtiness as "still working" here would pin every fast-pair
# session at `processing` whenever anyone else left a file open. The main tree
# gets its own guard instead: check 2 of `crew done`.
# pair_tickets → the nnn of every Backlog item that is in-progress AND declares
# `execution: fast-pair`. Every other executor is found from its branch, but a
# fast-pair ticket has no work branch by design, so it must be found from the
# other side: the ticket itself says where it runs.
# main_branch → the branch the MAIN tree actually has checked out, or (detached).
# One function because 0.37.0 shipped two readers of this same fact — the board's
# `main tree:` block asked git, the executors row printed the CONFIGURED dev
# branch — and a tree parked on another branch made one board name it two ways
# four lines apart. A shared reader cannot disagree with itself.
main_branch() {
  git -C "$MAIN" symbolic-ref --short HEAD 2>/dev/null || echo '(detached)'
}

pair_tickets() {
  grep -rlE "^status:[[:space:]]*\"?in-progress\"?" "$MAIN/docs/23_backlog" 2>/dev/null \
    | while IFS= read -r f; do
        [ "$(front "$f" execution)" = "fast-pair" ] || continue
        pt="$(front "$f" id)"
        echo "${pt#BACKLOG-}"
      done
}

pair_state() {
  if has_closer "$MAIN" "$1" -50 "$(cfg dev_branch main)"; then closed_state "$1"; else echo processing; fi
}

# A checkout is not a working environment: dep dirs, nested harness repos and
# env files are gitignored, so they must be put back deliberately. With a
# persistent pool this is paid once per executor instead of once per ticket.
provision() { # provision <worktree> <label>
  WT="$1"; LBL="$2"; T0="$(date +%s)"
  for d in $(cfg copy "node_modules"); do
    if [ -e "$MAIN/$d" ] && [ ! -e "$WT/$d" ]; then
      mkdir -p "$(dirname "$WT/$d")"
      # APFS clonefile (cp -c) turns gigabytes into seconds; plain copy elsewhere.
      cp -Rc "$MAIN/$d" "$WT/$d" 2>/dev/null || cp -R "$MAIN/$d" "$WT/$d"
      note "copied $d"
    fi
  done
  for d in $(cfg link ""); do
    if [ -e "$MAIN/$d" ] && [ ! -e "$WT/$d" ]; then
      mkdir -p "$(dirname "$WT/$d")"
      ln -s "$MAIN/$d" "$WT/$d"
      note "linked $d (shared read-only — never link something a ticket edits)"
    fi
  done
  # briefs/ is gitignored on purpose, so a fresh checkout arrives without it.
  if [ -d "$MAIN/briefs" ] && [ ! -e "$WT/briefs" ]; then
    cp -R "$MAIN/briefs" "$WT/briefs"
    note "copied briefs/ (gitignored — it does not follow a worktree on its own)"
  fi
  run_setup "$WT" "$LBL"
  log_line SETUP "$LBL" - "$(( $(date +%s) - T0 ))"
}

# A persistent tree keeps last ticket's dependencies, which is the whole saving
# and also the whole new hazard: a ticket that moved a lockfile would otherwise
# leave the next one testing against the wrong tree. So setup_cmd re-runs when
# a `resetup_when` file changed since this executor was last set up, and is
# skipped when none did. The key file is a cache key, never a source of truth.
setup_key() {
  for f in $(cfg resetup_when "package-lock.json yarn.lock pnpm-lock.yaml requirements.txt go.sum Gemfile.lock Cargo.lock"); do
    [ -f "$1/$f" ] && cat "$1/$f"
  done 2>/dev/null | cksum | awk '{print $1 "-" $2}'
}

# repo_cmd <log name> <label> <dir> <command> <lines shown on a pass>
# A repo's own command — typecheck, tests, setup — writes its whole output to
# $STATE/logs/<log name>.log, and the terminal gets only what a session acts on:
# on a pass, the last lines (a test runner's counts), on a failure the last 40,
# on stderr, and the path either way, so the rest is one read away. Measured
# 2026-09-26: one green `crew done` printed 10,539 characters of passing tests
# into the executor's context, above the one line that decided the run, and
# executors had begun piping `crew done` through `tail -40` or `grep -v ✔`
# themselves — filters that drop crew's own notes along with the noise.
repo_cmd() {
  RC_LOG="$STATE/logs/$1.log"
  if ! mkdir -p "$STATE/logs" 2>/dev/null; then
    ( cd "$3" && eval "$4" )   # nowhere to log: stream it, as before 0.42.4
    return $?
  fi
  note "$2 — output in $RC_LOG"
  ( cd "$3" && eval "$4" ) >"$RC_LOG" 2>&1
  RC_RC=$?
  if [ "$RC_RC" -eq 0 ]; then
    note "$2 passed"
    [ "$5" -gt 0 ] && grep -v '^[[:space:]]*$' "$RC_LOG" | tail -n "$5" | sed 's/^/  /'
    return 0
  fi
  grep -v '^[[:space:]]*$' "$RC_LOG" | tail -n 40 | sed 's/^/  /' >&2
  return "$RC_RC"
}

run_setup() { # run_setup <worktree> <label>
  SETUP="$(cfg setup_cmd "")"
  [ -n "$SETUP" ] || return 0
  KF="$STATE/keys/$(basename "$1")"
  KEY="$(setup_key "$1")"
  if [ -f "$KF" ] && [ "$(cat "$KF")" = "$KEY" ]; then
    note "deps unchanged since $2 was set up — setup_cmd skipped"
    return 0
  fi
  repo_cmd "setup-$(basename "$1")" setup_cmd "$1" "$SETUP" 0 \
    || note "setup_cmd failed — the tree may not test cleanly; its last lines are above, all of it in $RC_LOG"
  mkdir -p "$STATE/keys" && printf '%s\n' "$KEY" > "$KF"
}

# ---------------------------------------------------------------- crew executor
cmd_executor() {
  require_on
  DEV="$(cfg dev_branch main)"
  case "${1:-}" in
    add)
      K=1
      while [ -e "$(dirname "$MAIN")/${REPO}-e${K}" ]; do K=$((K + 1)); done
      WT="$(dirname "$MAIN")/${REPO}-e${K}"
      git -C "$MAIN" worktree add --detach "$WT" "$DEV" >/dev/null || die "worktree add failed"
      provision "$WT" "e$K"
      note "executor e$K at $WT — provisioned once, kept across tickets"
      ;;
    rm)
      K="${2:?usage: crew executor rm <k>}"
      WT="$(dirname "$MAIN")/${REPO}-e${K#e}"
      [ -d "$WT" ] || die "no executor at $WT"
      B="$(exec_map | awk -F'\t' -v w="$WT" '$1 == w { print $2 }')"
      [ "$B" = "-" ] || die "e${K#e} still holds $B — land it with crew done first"
      git -C "$MAIN" worktree remove --force "$WT" || die "worktree remove refused — inspect $WT"
      rm -f "$STATE/keys/$(basename "$WT")"
      note "executor e${K#e} removed"
      ;;
    prune)
      # Growth is automatic, so shrinking has to be ONE command or the pool only
      # ratchets up and the reader ceiling becomes decoration. Idle trees only:
      # one holding a branch is somebody's open ticket, and it is named, never
      # removed. The floor defaults to the documented starting pool.
      FLOOR="${2:-2}"
      case "$FLOOR" in ''|*[!0-9]*) die "usage: crew executor prune [floor]" ;; esac
      mkdir -p "$STATE"
      exec_map | awk -F'\t' '$2 != "-" { print $1 }' | while IFS= read -r P; do
        [ -n "$P" ] && note "kept $(en "$P") — still holds $(git -C "$P" symbolic-ref --short HEAD 2>/dev/null)"
      done
      exec_map | awk -F'\t' '$2 == "-" { print $1 }' > "$STATE/.prune"
      GONE=0
      while IFS= read -r P; do
        [ -n "$P" ] || continue
        [ "$(exec_map | wc -l | tr -d ' ')" -le "$FLOOR" ] && break
        if git -C "$MAIN" worktree remove --force "$P" 2>/dev/null; then
          rm -f "$STATE/keys/$(basename "$P")"
          GONE=$((GONE + 1))
          note "removed $(en "$P")"
        else
          note "could not remove $(en "$P") — inspect $P by hand"
        fi
      done < "$STATE/.prune"
      rm -f "$STATE/.prune"
      log_line PRUNE - - "removed=$GONE pool=$(exec_map | wc -l | tr -d ' ')"
      note "pool is now $(exec_map | wc -l | tr -d ' ') (removed $GONE, floor $FLOOR)"
      ;;
    *) die "usage: crew executor add|rm <k>|prune [floor]  (the board is: crew status)" ;;
  esac
}

# ---------------------------------------------------------------- crew new
cmd_new() {
  require_on
  CHAIN=0; NA=""
  for a in "$@"; do
    case "$a" in
      --chain) CHAIN=1 ;;
      *)       NA="$a" ;;
    esac
  done
  N="$(norm "${NA:?usage: crew new <nnn> [--chain]}")"
  F="$(ticket_file "$N")"
  # No ticket, no branch: ids are allocated read-then-write on the main tree, and
  # a worktree that allocated its own would collide deterministically (EXECUTION §1).
  [ -n "$F" ] || die "BACKLOG-$N not found under docs/23_backlog — no ticket, no branch (EXECUTION §1)"
  [ "$(front "$F" status)" = "done" ] && die "BACKLOG-$N is already done"
  DEV="$(cfg dev_branch main)"
  # A chained ticket starts only from a dev branch that already holds its
  # predecessor: it edits what that one builds, so a branch cut earlier starts
  # without the files it is about to change. "Landed" is either half of a
  # close-out — the closer on the dev branch, or the doc reading done — because
  # the gap between the two halves is real (ISSUE-014) and the code is already
  # there in it. Checked BEFORE the fast-pair branch below, so a fast-pair session
  # in a chain hears "wait" before it hears "no executor".
  AF="$(front "$F" after_ref)"
  if [ -n "$AF" ]; then
    case "$AF" in
      BACKLOG-[0-9]*) ;;
      *) die "[new:after] BACKLOG-$N has after_ref: $AF — a chain links Backlog items only (EXECUTION §1)" ;;
    esac
    AN="$(norm "$AF")"
    if ! has_closer "$MAIN" "$AN" -50 "$DEV" && ! ticket_done "$AN"; then
      AH="$(exec_on "work/b$AN")"
      if [ -n "$AH" ] && carried "$AN"; then
        note "BACKLOG-$AN is open in $(en "$AH") — the session there carries this chain, and its crew done $AN opens $N in the same tree"
      elif [ -n "$AH" ]; then
        note "BACKLOG-$AN is open in $(en "$AH") for that ticket alone — once it lands, $N needs a session of its own: $(next_cmd "$N")"
      fi
      die "[new:after] BACKLOG-$N runs after BACKLOG-$AN, which has not landed on $DEV — started now, it would not have the files $AN builds"
    fi
  fi
  if [ "$(front "$F" execution)" = "fast-pair" ]; then
    note "BACKLOG-$N is fast-pair: work on the dev branch in the main tree and commit in the same bout"
    note "session  : it still gets one — title it $(exec_title "$N" main processing)"
    die "no executor for a fast-pair ticket (EXECUTION §2)"
  fi
  BR="work/b$N"

  # Everything from "who is free" to "the branch is checked out" is one critical
  # section: read and claim must not be separable, or two commands claim the
  # same tree (see claim_lock). Provisioning stays OUTSIDE it — it can run for
  # minutes, and by then the tree is already this ticket's.
  claim_lock
  HOLD="$(exec_on "$BR")"
  [ -n "$HOLD" ] && { claim_unlock; die "BACKLOG-$N is already open in $(en "$HOLD") ($HOLD)"; }
  if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BR"; then
    claim_unlock
    die "branch $BR exists but no executor holds it — resume it: git -C <executor> switch $BR"
  fi

  # The tree is found, not built — that is the change from the per-ticket model.
  # But a pool size is a GUESS, and a guess must not block a ticket: with none
  # free, grow by one instead of refusing. Only the `worktree add` runs inside
  # the mutex, because it is what reserves the name; provisioning can take
  # minutes and happens after the claim is already this ticket's.
  # The free executor the session is STANDING in comes first. A chain session
  # whose `crew done` could not hand its tree straight on (--park, a fast-pair
  # link, a leftover file cleared by hand) resumes here, and taking the first
  # free tree instead would move it to another place mid-chain and rename it.
  WT=""
  HT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  case "$(basename "${HT:-.}")" in
    "$REPO"-e[0-9]*)
      HP="$(exec_map | awk -F'\t' -v n="$(basename "$HT")" '$2 == "-" { b = $1; sub(/.*\//, "", b); if (b == n) { print $1; exit } }')"
      [ -n "$HP" ] && [ "$(own_dirty "$HP")" -eq 0 ] && WT="$HP"
      ;;
  esac
  [ -n "$WT" ] || WT="$(exec_free)"
  GREW=0
  if [ -z "$WT" ]; then
    K=1
    while [ -e "$(dirname "$MAIN")/${REPO}-e${K}" ]; do K=$((K + 1)); done
    WT="$(dirname "$MAIN")/${REPO}-e${K}"
    git -C "$MAIN" worktree add --detach "$WT" "$DEV" >/dev/null 2>&1 \
      || { claim_unlock; die "no executor was free and e$K could not be created at $WT"; }
    GREW=1
  fi
  git -C "$WT" switch -c "$BR" "$DEV" >/dev/null 2>&1 \
    || { claim_unlock; die "could not start $BR in $WT"; }
  claim_unlock

  if [ "$GREW" -eq 1 ]; then
    POOL="$(exec_map | wc -l | tr -d ' ')"
    CAP="$(cfg reader_cap 4)"
    log_line GROW "$(en "$WT")" "BACKLOG-$N" "pool=$POOL"
    note "no executor was free, so $(en "$WT") was created for this ticket (pool=$POOL)"
    # Warn, never block: the ceiling is about one human reading results, and
    # shrinking is a deliberate act once the burst is over (EXECUTION §5).
    [ "$POOL" -gt "$CAP" ] \
      && note "pool is past the reader ceiling of $CAP — shrink it when this burst ends: scripts/crew executor rm <k>"
    provision "$WT" "$(en "$WT")"
  else
    run_setup "$WT" "$(en "$WT")"
  fi

  # The trailing " chain" is what `carried` reads back; it goes last so the path
  # before it may hold any character but a tab.
  if [ "$CHAIN" -eq 1 ]; then log_line NEW "$(en "$WT")" "BACKLOG-$N" "$WT chain"; else log_line NEW "$(en "$WT")" "BACKLOG-$N" "$WT"; fi
  SEG="$(chain_seg "$N")"
  NXT="$(chain_awk next "$N" | cut -f1)"
  note "executor : $(en "$WT")  $WT  (branch $BR, from $DEV)"
  note "session  : title it $(exec_title "$N" "$(en "$WT")" processing)  (scripts/crew name executor)"
  note "finish   : scripts/crew done $N   (from anywhere in the repo)"
  if [ "$CHAIN" -eq 1 ] && [ -n "$NXT" ]; then
    note "chain    : ${SEG% · } — this session carries it: crew done $N opens BACKLOG-$NXT in this same tree"
  elif [ "$CHAIN" -eq 1 ]; then
    note "chain    : nothing runs after BACKLOG-$N, so --chain changes nothing — crew done parks the tree as usual"
  elif [ -n "$NXT" ]; then
    note "chain    : ${SEG% · } — opened without --chain, so this session takes BACKLOG-$N alone: crew done parks the tree, and BACKLOG-$NXT waits for a session given the chain"
  fi
  return 0
}

# ---------------------------------------------------------------- crew done
# THE CLOSE-OUT IS COMMITTED, AND ONLY THE CLOSE-OUT. Until 0.41.1 docs_close's
# writes — the Backlog doc's `status: done` and the audit line — stayed
# uncommitted in the main tree, so the very next `crew done` died at check 2
# naming exactly those two files. Reproduced 2026-09-24 with two tickets back to
# back; a chain session (0.41.0) met it on every ticket after the first. The push
# also ran before the close-out, so even a hand-committed close-out reached the
# remote one ticket late, and the last ticket's not at all.
#
# "What docs_close wrote" is measured AND bounded. Measured: the paths that became
# dirty while it ran, because the main tree is shared and a fast-pair session can
# start an edit after check 2. Bounded: `docs_close --apply --refresh` (no
# --archive) can only write a Backlog doc's status, `92_audit/LOG.md`, and since
# 0.42.4 the `INDEX.md` and `MAP.tsv` it regenerates when the repo keeps them —
# left out, the index went stale on the dev branch, and rendering it in the shared
# tree would have left files check 2 refuses the next merge on. `--refresh` is
# this command's to pass because this command commits the result. Nothing outside
# those is ever a close-out, even if it changed in the same second. A path that
# was already dirty when the close-out started holds somebody else's edit, so it
# is left out and named, never committed under the close-out's name. A refused
# commit (a repo's own pre-commit hook) is reported, never bypassed, and never
# fails a merge that has already landed.
main_changed() { # → paths in the main tree that differ from HEAD or are untracked, sorted
  # quotepath off: a non-ASCII file name must come back as a path `git add` can
  # take, not as an octal-escaped string.
  { git -C "$MAIN" -c core.quotepath=off diff --name-only HEAD 2>/dev/null
    git -C "$MAIN" -c core.quotepath=off ls-files --others --exclude-standard 2>/dev/null
  } | sort -u
}
closeout_scope() { grep -E '^docs/(23_backlog/.*\.md|92_audit/LOG\.md|INDEX\.md|MAP\.tsv)$' || true; }
closeout_commit() { # closeout_commit <nnn> <paths dirty before docs_close ran>
  # Read both arguments NOW: `set --` below reuses the positional parameters to
  # hold the paths, and a later "$1" would be the first path, not the ticket.
  CO_N="$1"
  CO_NEW="$(comm -13 <(printf '%s\n' "$2") <(main_changed) | closeout_scope)"
  CO_HELD="$(printf '%s\n' "$2" | closeout_scope)"
  if [ -n "$CO_HELD" ]; then
    note "[done:closeout] these already had uncommitted edits when the close-out ran, so they stay out of its commit — whoever owns the edits commits them:"
    printf '%s\n' "$CO_HELD" | sed 's/^/  /'
  fi
  [ -n "$CO_NEW" ] || return 0
  set --
  CO_IDS=""
  while IFS= read -r co_p; do
    [ -n "$co_p" ] || continue
    set -- "$@" "$co_p"
    case "$co_p" in
      docs/23_backlog/*) co_id="$(front "$MAIN/$co_p" id)"; [ -n "$co_id" ] && CO_IDS="$CO_IDS, $co_id" ;;
    esac
  done <<CO_PATHS
$CO_NEW
CO_PATHS
  CO_IDS="${CO_IDS#, }"
  [ -n "$CO_IDS" ] || CO_IDS="BACKLOG-$CO_N"
  if git -C "$MAIN" add -- "$@" \
     && git -C "$MAIN" commit -q --only -m "docs: close-out $CO_IDS" \
          -m "Written by crew done $CO_N through docs_close (STANDARD §6.1): only the files it wrote." \
          -- "$@"; then
    note "close-out committed on $(main_branch): $CO_IDS"
  else
    git -C "$MAIN" reset -q -- "$@" 2>/dev/null
    note "[done:closeout] the close-out was written but not committed (git's reason is above); commit these before the next crew done, or check 2 will refuse it:"
    printf '%s\n' "$@" | sed 's/^/  /'
  fi
}

cmd_done() {
  require_on
  PARK=0; NA=""
  for a in "$@"; do
    case "$a" in
      --park) PARK=1 ;;
      *)      NA="$a" ;;
    esac
  done
  N="$(norm "${NA:?usage: crew done <nnn> [--park]}")"
  DEV="$(cfg dev_branch main)"
  TYPECHECK="$(cfg typecheck_cmd "")"
  TEST="$(cfg test_cmd "")"
  WT="$(exec_on "work/b$N")"
  [ -n "$WT" ] || die "no executor holds work/b$N — fast-pair tickets close by trailer alone (EXECUTION §2)"

  # Check 0 — the executor's own tree, before anything is merged. Step 2 below
  # tests exactly what is about to land, and a tree carrying uncommitted work of
  # its own means what lands is NOT what the session has. This check already
  # existed at the very END of this command, as the park refusal; measured
  # 2026-09-09, that is hours too late: by then the merge had happened and the
  # ticket read `status: done` with an audit line, while the file sat unlanded.
  # Same test, moved in front of the merge. `own_files` excludes crew's
  # provisioned payload, so it names only somebody's real work.
  LEFT="$(own_files "$WT")"
  if [ -n "$LEFT" ]; then
    echo "$LEFT" | sed 's/^/  /' >&2
    die "check 0: $(en "$WT") has uncommitted work (files above) — commit or drop it, then rerun crew done $N"
  fi

  tries=0
  while :; do
    # 1. Conflicts are resolved in the ticket's own tree, never on the main tree.
    git -C "$WT" merge --no-edit "$DEV" >/dev/null 2>&1 \
      || die "merge of $DEV into work/b$N has conflicts — resolve in $WT, then rerun"
    # 2. Test exactly what is about to land: the post-merge tree. The output
    #    goes to a log (repo_cmd); a pass shows the runner's last 8 lines,
    #    which is where node, jest, vitest and pytest print their counts.
    if [ -n "$TYPECHECK" ]; then
      repo_cmd "b$N-typecheck" typecheck "$WT" "$TYPECHECK" 0 \
        || die "typecheck failed in $WT — last lines above, all of it in $RC_LOG"
    fi
    if [ -n "$TEST" ]; then
      repo_cmd "b$N-test" tests "$WT" "$TEST" 8 \
        || die "tests failed in $WT — fix there, rerun crew done $N; last lines above, all of it in $RC_LOG"
    fi
    ACTUAL="$(git -C "$WT" diff --name-only "$DEV" | wc -l | tr -d ' ')"
    # 3. Check 1 — a merge lands on whatever branch the main tree HOLDS,
    #    not on the branch you assume. This check is not decoration.
    CUR="$(git -C "$MAIN" symbolic-ref --short HEAD 2>/dev/null || echo '(detached)')"
    [ "$CUR" = "$DEV" ] || die "check 1: main tree has '$CUR' checked out, expected '$DEV'"
    # 4. Check 2 — a dirty main tree is usually an open fast-pair edit. Name
    #    the files instead of failing blind. Known limit, stated on purpose:
    #    a clean tree does NOT mean nobody is reading it (EXECUTION §6).
    DIRTY="$(git -C "$MAIN" status --porcelain)"
    if [ -n "$DIRTY" ]; then
      echo "$DIRTY" | sed 's/^/  /' >&2
      die "check 2: main tree is dirty (files above) — an open fast-pair edit, or a close-out nobody committed ([done:closeout])? commit or stash it, then rerun"
    fi
    # 5. Fast-forward only; if the dev branch moved underneath us, go around
    #    (merge → test → checks) at most twice, then hand it back to a human.
    if git -C "$MAIN" merge --ff-only "work/b$N" >/dev/null 2>&1; then
      break
    fi
    tries=$((tries + 1))
    [ "$tries" -ge 2 ] && die "$DEV kept moving (2 retries) — rerun when the fast-pair burst settles"
    note "$DEV moved under the merge — retry $tries/2"
  done

  # 6. Close-out through the trailer (STANDARD §6.1): the audit line should cite
  #    a sha, not a session's recollection. It runs BEFORE the push, and its
  #    writes are committed (closeout_commit), so the remote gets the merge and
  #    the close-out together.
  if has_closer "$MAIN" "$N" -50 "$DEV"; then
    DC="${CREW_DOCS_CLOSE:-}"
    if [ -z "$DC" ] && [ -f "${CLAUDE_PLUGIN_ROOT:-/nonexistent}/scripts/docs_close.sh" ]; then
      DC="$CLAUDE_PLUGIN_ROOT/scripts/docs_close.sh"
    fi
    if [ -z "$DC" ]; then
      # Search for the FILE, never for a directory named docs-kit: the marketplace
      # cache nests a version between the two (.../docs-kit/0.29.0/scripts/...), so
      # joining scripts/docs_close.sh onto that directory never resolves. Every
      # machine where CLAUDE_PLUGIN_ROOT is unset — which is every plain terminal —
      # therefore skipped the close-out and only printed the note (ISSUE-014).
      # `sort -V` takes the highest version instead of whichever path find walks
      # first, and plain `sort` is the fallback where sort has no -V (bash 3.2).
      DCC="$(find ~/.claude/plugins -maxdepth 8 -type f -name docs_close.sh -path '*docs-kit*' 2>/dev/null)"
      DC="$(printf '%s\n' "$DCC" | sort -V 2>/dev/null | tail -1)"
      [ -f "$DC" ] || DC="$(printf '%s\n' "$DCC" | sort | tail -1)"
      [ -f "$DC" ] || DC=""
    fi
    if [ -n "$DC" ]; then
      CO_BEFORE="$(main_changed)"
      bash "$DC" --apply --refresh "$MAIN" || note "docs_close reported a problem — check its output"
      closeout_commit "$N" "$CO_BEFORE"
    else
      note "trailer found but docs_close is not reachable — /docs-kit:docs-sync will flip the status"
    fi
  else
    note "no 'Closes: BACKLOG-$N' trailer on $DEV — set status: done + audit line yourself, or via docs-sync (STANDARD §6.1)"
  fi

  if git -C "$MAIN" remote | grep -q .; then
    git -C "$MAIN" push origin "$DEV" "work/b$N" || note "push failed — push by hand when the remote is back"
  else
    note "no remote configured — push skipped"
  fi

  # Size calibration: declared S (planner's estimate) vs files actually touched.
  # This log is how the split threshold S > 6 stops resting on one data point.
  F="$(ticket_file "$N")"
  DECLARED="-"
  [ -n "$F" ] && DECLARED="$(front "$F" scope_files)" && [ -n "$DECLARED" ] || DECLARED="-"
  log_line SIZE - "BACKLOG-$N" "declared=$DECLARED actual=$ACTUAL"

  # Release anything the ticket still holds, then remove the tree.
  if [ -d "$STATE/locks" ]; then
    for LF in "$STATE"/locks/*.lock; do
      [ -f "$LF" ] || continue
      if [ "$(sed -n 1p "$LF")" = "BACKLOG-$N" ]; then
        RES="$(basename "$LF" .lock)"
        HELD=$(( $(date +%s) - $(sed -n 2p "$LF") ))
        rm -f "$LF"
        log_line RELEASE "$RES" "BACKLOG-$N" "$HELD"
        note "released lock $RES (held ${HELD}s)"
      fi
    done
  fi
  # Park the executor rather than destroy it. The safety property is the one the
  # old teardown had: anything untracked that crew did not put there is somebody's
  # uncommitted work, so it keeps the tree and gets named (EXECUTION §6).
  SAFE=1
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    SAFE=0; note "unmerged leftover: $p"
  done <<LEFTOVERS
$(own_files "$WT")
LEFTOVERS
  # THE CHAIN NEVER LETS GO OF ITS TREE. When a ticket runs after this one, the
  # tree goes straight from work/b<this> to work/b<next>, cut from the dev branch
  # that now holds this merge, and is never parked in between. A parked tree is a
  # FREE tree — exec_free reads "detached and clean" and nothing else — so the
  # gap between this command and the session's own `crew new <next>` is exactly
  # the window in which another session's `crew new` takes the tree the chain
  # session is sitting in. Held across the switch by the same mutex `crew new`
  # claims under, so a concurrent claim of <next> sees one of the two outcomes
  # and never both. The pin stays the checked-out branch: no reservation file.
  # Only for a session that CARRIES the chain (see carried): one that opened this
  # ticket alone gets the park a lone ticket gets, and is told what comes next.
  HANDED=""
  if [ "$SAFE" -eq 1 ] && [ "$PARK" -eq 0 ]; then
    NXL="$(chain_awk next "$N")"
    NX="$(printf '%s' "$NXL" | cut -f1)"
    NXX="$(printf '%s' "$NXL" | cut -f2)"
    NXO="$(printf '%s' "$NXL" | cut -f3)"
    if [ -n "$NX" ] && [ "$NXX" = "fast-pair" ]; then
      # A fast-pair link runs in the main tree by definition, so there is nothing
      # to hold this tree for; the chain session carries on from the main tree.
      note "BACKLOG-$NX comes next and is fast-pair — it runs in the main tree, so $(en "$WT") is parked"
    elif [ -n "$NX" ] && ! carried "$N"; then
      note "[done:alone] BACKLOG-$NX runs after BACKLOG-$N, but this session opened $N without --chain, so $(en "$WT") is parked — the chain goes on in a session given it: $(next_cmd "$NX")"
    elif [ -n "$NX" ]; then
      claim_lock
      if [ -n "$(exec_on "work/b$NX")" ]; then
        note "BACKLOG-$NX comes next but is already open in $(en "$(exec_on "work/b$NX")") — $(en "$WT") is parked"
      elif git -C "$MAIN" show-ref --verify --quiet "refs/heads/work/b$NX"; then
        note "BACKLOG-$NX comes next but branch work/b$NX already exists — resume it by hand; $(en "$WT") is parked"
      elif git -C "$WT" switch -c "work/b$NX" "$DEV" >/dev/null 2>&1; then
        HANDED="$NX"
      else
        note "could not open work/b$NX in $(en "$WT") — $(en "$WT") is parked; take it with: scripts/crew new $NX"
      fi
      claim_unlock
    fi
    [ -n "$NXO" ] && note "also after BACKLOG-$N: $NXO — a fork; each of those needs a session of its own (scripts/crew new <nnn>)"
  fi
  if [ -n "$HANDED" ]; then
    run_setup "$WT" "$(en "$WT")"
    log_line NEW "$(en "$WT")" "BACKLOG-$HANDED" "$WT after=BACKLOG-$N chain"
    note "$(en "$WT") stays busy: the chain goes on with BACKLOG-$HANDED on work/b$HANDED (from $DEV, which now holds $N)"
    # Progress in the board's own words, one line, so a person following the
    # session reads where the chain stands without opening crew status.
    CROW="$(chain_awk board "$(chain_holders)" "$HANDED" | head -1)"
    [ -n "$CROW" ] && note "chain    : ${CROW#  }"
  elif [ "$SAFE" -eq 1 ]; then
    if git -C "$WT" switch --detach "$DEV" >/dev/null 2>&1; then
      git -C "$WT" reset --hard >/dev/null 2>&1
      note "$(en "$WT") is free — its deps stay in place for the next ticket"
    else
      note "could not park $(en "$WT") — park it by hand: git -C $WT switch --detach $DEV"
    fi
  else
    note "$(en "$WT") stays on work/b$N: the files above are neither committed nor crew-provisioned — commit or delete them, then: git -C $WT switch --detach $DEV"
  fi
  log_line DONE - "BACKLOG-$N" "files=$ACTUAL"
  # Warn, never refuse: the stray commit is already on the shared dev branch, so
  # refusing here undoes nothing and only holds back the close-out (closer_split).
  BPS="$(bypass_shas "$N")"
  if [ -n "$BPS" ]; then
    log_line BYPASS - "BACKLOG-$N" "$BPS"
    note "[done:bypass] BACKLOG-$N was also closed on $DEV by $BPS, a commit not made on work/b$N — it skipped check 0, the tests and checks 1–2. It landed anyway, since it is already on the shared $DEV. Say so in the final report; a ticket's commits belong in its executor tree."
  fi
  note "BACKLOG-$N is on $DEV. Reminder: a clean main tree does not mean nobody is reading it."
  if [ -n "$HANDED" ]; then
    note "next     : same session, same tree — retitle with scripts/crew name executor, then work BACKLOG-$HANDED"
  elif carried "$N"; then
    # The carrying session's last crew done: the rows its final report is built
    # from, measured rather than recalled — the sha that closed each ticket on
    # the dev branch and the declared/actual size crew logged for it.
    CRUN="$(carried_run "$N")"
    CR1="${CRUN%% *}"
    if [ "$CR1" = "BACKLOG-$N" ]; then note "carried  : BACKLOG-$N, for the final report —"
    else note "carried  : $CR1 → BACKLOG-$N, for the final report —"
    fi
    for CT in $CRUN; do
      CSHA="$(git -C "$MAIN" log -1 --format=%h --grep="^Closes: $CT\$" "$DEV" 2>/dev/null)"
      CSZ="$(awk -F'\t' -v t="$CT" '$2 == "SIZE" && $3 == "-" && $4 == t { s = $5 } END { print s }' "$STATE/log.tsv" 2>/dev/null)"
      CTF="$(ticket_file "${CT#BACKLOG-}")"
      CST="-"; [ -n "$CTF" ] && CST="$(front "$CTF" status)"
      CBP="$(bypass_shas "${CT#BACKLOG-}")"
      echo "  $CT  ${CSHA:--}  ${CSZ:--}  status=${CST:--}${CBP:+  bypass=$CBP}"
    done
    CNX="$(chain_awk next "$N" | cut -f1)"
    [ -n "$CNX" ] && echo "  not carried yet: BACKLOG-$CNX — $(next_cmd "$CNX")"
  fi
  return 0
}

# ---------------------------------------------------------------- crew lock
cmd_lock() {
  require_on
  ACTION="${1:?usage: crew lock acquire|release <resource> <nnn> [--wait]}"
  RES="${2:?resource name required}"
  N="$(norm "${3:?ticket number required}")"
  WAIT="${4:-}"
  OWNER="BACKLOG-$N"
  mkdir -p "$STATE/locks"
  LF="$STATE/locks/$RES.lock"
  case "$ACTION" in
    acquire)
      T0="$(date +%s)"
      # The WRITE is the test, via O_EXCL (`set -C`). Check-then-write is not a
      # lock: measured 2026-09-08, two concurrent acquires on one resource both
      # reported success in 5 runs out of 5 while the file recorded a single
      # owner — two sessions each believing they hold the rig is the exact
      # failure this file exists to prevent. Same file format as before.
      while ! ( set -C; printf '%s\n%s\n' "$OWNER" "$(date +%s)" > "$LF" ) 2>/dev/null; do
        HOLDER="$(sed -n 1p "$LF")"
        [ "$HOLDER" = "$OWNER" ] && { note "$RES already held by $OWNER"; return 0; }
        if [ "$WAIT" = "--wait" ]; then
          sleep 5
        else
          log_line WAIT "$RES" "$OWNER" "holder=$HOLDER"
          die "$RES is held by $HOLDER — queue with: crew lock acquire $RES $N --wait"
        fi
      done
      WAITED=$(( $(date +%s) - T0 ))
      log_line ACQUIRE "$RES" "$OWNER" "$WAITED"
      note "$RES acquired by $OWNER (waited ${WAITED}s)"
      ;;
    release)
      [ -f "$LF" ] || die "$RES is not held"
      HOLDER="$(sed -n 1p "$LF")"
      [ "$HOLDER" = "$OWNER" ] || die "$RES is held by $HOLDER, not $OWNER — not released"
      HELD=$(( $(date +%s) - $(sed -n 2p "$LF") ))
      rm -f "$LF"
      log_line RELEASE "$RES" "$OWNER" "$HELD"
      note "$RES released (held ${HELD}s)"
      ;;
    *) die "unknown lock action: $ACTION" ;;
  esac
}

# ---------------------------------------------------------------- main tree
# What the MAIN tree has checked out, and how far it sits from the dev branch.
#
# WHY THIS IS ON THE BOARD: `crew done` merges onto whatever the main tree holds
# at that moment, so its check 1 refuses when that is not the dev branch and its
# check 2 refuses when the tree is dirty. Both were reachable only by starting a
# merge and reading the refusal — the board never said which branch was under
# the whole pool, and the main tree is the one checkout nothing else here lists.
# So this asks check 1's and check 2's questions before a ticket is in flight.
#
# It prints the branch NAME rather than only a verdict, because the person
# reading is the one who knows whether being on that branch is deliberate. The
# `default` row follows the same rule for origin/HEAD.
main_tree_block() {
  MT_DEV="$(cfg dev_branch main)"
  MT_CUR="$(main_branch)"
  # Plain porcelain, deliberately NOT own_files(): check 2 counts every
  # uncommitted file in the main tree, provisioned payload included, so a board
  # that filtered would promise a merge the merge itself refuses.
  MT_DIRTY="$(git -C "$MAIN" status --porcelain 2>/dev/null | grep -c . || true)"
  MT_STATE=clean
  [ "${MT_DIRTY:-0}" -gt 0 ] && MT_STATE="${MT_DIRTY} uncommitted"

  echo "main tree:"
  if [ "$MT_CUR" = "$MT_DEV" ]; then
    printf '  %-10s: %s\n' "branch" "$MT_CUR = dev_branch · $MT_STATE"
  else
    printf '  %-10s: %s\n' "branch" "$MT_CUR ≠ dev_branch '$MT_DEV' · $MT_STATE"
  fi

  # Two different questions wear the same words. On the dev branch, "in sync"
  # means in step with the remote; anywhere else it means "is this work already
  # in dev". Compare against whichever the answer is actually about, and label
  # the line with which one it was — the counts are meaningless otherwise.
  # `row` keeps the label column the same width as `branch` above; an unaligned
  # board is one people stop reading.
  row() { printf '  %-10s: %s\n' "$1" "$2"; }
  MT_REF=""
  MT_NAME=""
  if [ "$MT_CUR" = "$MT_DEV" ]; then
    MT_LBL="vs remote"
    MT_REF="$(git -C "$MAIN" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    MT_NAME=" $MT_REF"
    [ -n "$MT_REF" ] || row "$MT_LBL" "'$MT_CUR' tracks nothing here — nothing to compare"
  else
    MT_LBL="vs $MT_DEV"
    if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$MT_DEV"; then
      MT_REF="$MT_DEV"
      # The label already names it, so do not say it twice.
      MT_NAME=""
    else
      row "$MT_LBL" "that branch does not exist here"
    fi
  fi
  if [ -n "$MT_REF" ]; then
    # `rev-list --left-right --count REF...HEAD` prints "<behind> <ahead>": the
    # left side is what REF has and HEAD does not.
    MT_AB="$(git -C "$MAIN" rev-list --left-right --count "$MT_REF...HEAD" 2>/dev/null || true)"
    if [ -z "$MT_AB" ]; then
      row "$MT_LBL" "cannot compare with $MT_REF — no common history"
    else
      MT_BEHIND="$(printf '%s' "$MT_AB" | awk '{print $1+0}')"
      MT_AHEAD="$(printf '%s' "$MT_AB" | awk '{print $2+0}')"
      if [ "$MT_AHEAD" -eq 0 ] && [ "$MT_BEHIND" -eq 0 ]; then
        row "$MT_LBL" "in step with${MT_NAME:- $MT_REF}"
      else
        row "$MT_LBL" "$MT_AHEAD ahead, $MT_BEHIND behind$MT_NAME"
      fi
    fi
  fi

  # What the tools OUTSIDE crew take to be the default branch. Claude Code's diff
  # pane and the "Main branch … use this for PRs" line it loads into every
  # session both read refs/remotes/origin/HEAD (read out of CLI 2.1.275; when the
  # ref is unset it guesses origin/main, then origin/master). A clone points that
  # ref at the GitHub default, which in the commonest setup is prod_branch, so
  # between two releases every session diffed against prod and saw all the
  # unreleased work — 30 commits and 78 files in the repo that reported it — and
  # the PR hint named the one branch that takes no direct commit.
  # The ref lives in the git dir every worktree shares, so one command fixes the
  # whole pool; it is also local, so a fresh clone or `set-head -a` undoes it.
  # The row appears only when there is something to do, and the board never runs
  # the command: repointing a ref every tool reads is the user's call, asked in
  # crew-init and crew-update. A dev_branch that does not exist is left to the
  # note at the bottom of the board, one message per fault.
  if git -C "$MAIN" config --get remote.origin.url >/dev/null 2>&1 \
     && git -C "$MAIN" show-ref --verify --quiet "refs/heads/$MT_DEV"; then
    # Full ref name, not --short: a local branch literally named `origin/x`
    # would make the short form ambiguous.
    MT_OH="$(git -C "$MAIN" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || true)"
    MT_OH="${MT_OH#refs/remotes/origin/}"
    if [ "$MT_OH" != "$MT_DEV" ]; then
      # set-head refuses a target the remote-tracking refs do not have, so an
      # unpushed dev branch needs the push named first or the fix just errors.
      MT_FIX="git remote set-head origin $MT_DEV"
      git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$MT_DEV" \
        || MT_FIX="push '$MT_DEV' first, then $MT_FIX"
      if [ -n "$MT_OH" ]; then
        row "default" "origin/HEAD is '$MT_OH', not dev_branch '$MT_DEV' · $MT_FIX"
      else
        row "default" "origin/HEAD is not set, so tools guess · $MT_FIX"
      fi
    fi
  fi

  # One arrow, naming the checks by the number `crew done` prints, so the board
  # and the refusal say the same thing.
  MT_WHY=""
  [ "$MT_CUR" = "$MT_DEV" ] || MT_WHY="check 1 wants '$MT_DEV' checked out"
  [ "${MT_DIRTY:-0}" -gt 0 ] && MT_WHY="${MT_WHY:+$MT_WHY, }check 2 wants it clean"
  [ -n "$MT_WHY" ] && echo "  → crew done refuses here: $MT_WHY"
  return 0
}

# ---------------------------------------------------------------- direction
# The roadmap is Layer 1 STATE and the Backlog is what is being done; until
# 0.34.0 nothing compared the two, so the plan could go stale without one check
# going red. Measured on the origin repo 2026-09-10: `00_roadmap/roadmap.md`
# untouched for 10 days while 10 commits carried a `Closes:` trailer and 29
# audit lines landed; its `## Now` column named 4 tickets, all 4 already `done`
# and archived, and neither open ticket appeared in any column.
#
# Every number below is DERIVED from git and docs/. No state file, no config
# key, and no clock of its own: `CREW_NOW` overrides the epoch so the test suite
# does not depend on the day it runs.
ROADMAP="$MAIN/docs/00_roadmap/roadmap.md"
REPORTS="$MAIN/docs/92_audit/reports"

now_epoch() { echo "${CREW_NOW:-$(date +%s)}"; }

# tok <epoch> <fmt> — GNU date takes -d @<seconds>, BSD date takes -r <seconds>.
# GNU is tried first on purpose: its `-r` reads a FILE, so asking BSD first
# would make the answer depend on whether a file with that name happens to
# exist. Empty on failure — a line that cannot compute its verdict prints the
# fact without one rather than inventing it (the §8 fail-open doctrine).
tok() {
  date -u -d "@$1" "+$2" 2>/dev/null || date -u -r "$1" "+$2" 2>/dev/null || echo ""
}

# now_ids — Backlog ids cited in the roadmap's `## Now` column, in file order.
now_ids() {
  [ -f "$ROADMAP" ] || return 0
  awk '/^## Now/{f=1;next} /^## /{f=0} f' "$ROADMAP" \
    | grep -oE 'BACKLOG-[0-9]+' | LC_ALL=C sort -u
}

# open_ids — every Backlog item still open or in-progress. Read from `id:` and
# never from a filename: STANDARD §3 has no exception for that anywhere else.
open_ids() {
  [ -d "$MAIN/docs/23_backlog" ] || return 0
  grep -rlE '^status:[[:space:]]*"?(open|in-progress)"?' "$MAIN/docs/23_backlog" 2>/dev/null \
    | while read -r f; do front "$f" id; done \
    | grep -E '^BACKLOG-[0-9]+$' | LC_ALL=C sort -u
}

# last_report <regex> — newest report file matching a grammar, name only. The
# grammars sort lexically because both are zero-padded, so `sort | tail -1` is
# the newest without parsing a date.
last_report() {
  [ -d "$REPORTS" ] || return 0
  ls "$REPORTS" 2>/dev/null | grep -E "$1" | LC_ALL=C sort | tail -1
}

count() { grep -c 'BACKLOG-' 2>/dev/null || true; }

# closes_since <sha-or-empty> — commits declaring a completion. A trailer naming
# a ticket that does not exist still counts here: this measures what the repo
# said it finished, and `docs_close` is the half that checks the claim.
closes_since() {
  if [ -n "$1" ]; then
    git -C "$MAIN" log "$1..HEAD" --grep='Closes: BACKLOG-' --format=%H 2>/dev/null
  else
    git -C "$MAIN" log --since=@"$2" --grep='Closes: BACKLOG-' --format=%H 2>/dev/null
  fi
}

# report_sha <file> — the commit that last touched a report, or empty when the
# file is untracked. Empty is the honest answer: an uncommitted report has not
# closed a window yet.
report_sha() {
  [ -n "$1" ] || return 0
  git -C "$MAIN" log -1 --format=%H -- "$REPORTS/$1" 2>/dev/null
}

# roadmap_stats — one tab-separated line, so the board and `crew report` read the
# same numbers from one definition instead of two that drift:
#   listed <TAB> done <TAB> open <TAB> present <TAB> ids open but not in Now
# "done" counts a cited ticket that is `done` OR has no file at all: both mean
# the column is naming something that is not being worked on.
roadmap_stats() {
  RS_N="$(now_ids)"; RS_O="$(open_ids)"
  RS_NSP=" $(echo $RS_N) "
  RS_L=0; RS_D=0; RS_OC=0; RS_P=0; RS_M=""
  for i in $RS_N; do
    RS_L=$((RS_L + 1))
    RS_TF="$(ticket_file "${i#BACKLOG-}")"
    RS_ST="missing"
    [ -n "$RS_TF" ] && RS_ST="$(front "$RS_TF" status)"
    case "$RS_ST" in done|missing) RS_D=$((RS_D + 1)) ;; esac
  done
  for i in $RS_O; do
    RS_OC=$((RS_OC + 1))
    case "$RS_NSP" in
      *" $i "*) RS_P=$((RS_P + 1)) ;;
      *) RS_M="${RS_M:+$RS_M }$i" ;;
    esac
  done
  printf '%s\t%s\t%s\t%s\t%s\n' "$RS_L" "$RS_D" "$RS_OC" "$RS_P" "$RS_M"
}

# direction_block — two lines on the board, a third only when an id is missing,
# and an arrow only for a state something ACTS on. Same rule the executor states
# earned in 0.32.0: a word for `finishing` because `crew done` answers it, no
# word for "assigned but not started" because nothing does.
direction_block() {
  echo ""
  echo "direction:"
  if [ ! -f "$ROADMAP" ]; then
    echo "  roadmap     : docs/00_roadmap/roadmap.md missing — /docs-kit:docs-upgrade adds the seed"
    return 0
  fi
  # Read the columns with cut, NOT with `IFS=<tab> read <<heredoc`: the
  # assignment in front of `read` is still in effect while the heredoc's command
  # substitution runs, so `for i in $ids` inside roadmap_stats would split on
  # tabs instead of newlines and silently count one item. Measured: a Now column
  # naming two tickets reported "1 listed · 1 done".
  D_STATS="$(roadmap_stats)"
  D_L="$(printf '%s' "$D_STATS" | cut -f1)"
  D_D="$(printf '%s' "$D_STATS" | cut -f2)"
  D_O="$(printf '%s' "$D_STATS" | cut -f3)"
  D_P="$(printf '%s' "$D_STATS" | cut -f4)"
  D_M="$(printf '%s' "$D_STATS" | cut -f5)"
  D_AGE="uncommitted"
  D_CT="$(git -C "$MAIN" log -1 --format=%ct -- docs/00_roadmap/roadmap.md 2>/dev/null)"
  [ -n "$D_CT" ] && D_AGE="$(( ( $(now_epoch) - D_CT ) / 86400 ))d ago"
  echo "  roadmap Now : $D_L listed · $D_D done · $D_P of $D_O open present · edited $D_AGE"
  [ -n "$D_M" ] && echo "  not listed  : $D_M"

  D_WK="$(tok "$(now_epoch)" %G-W%V)"
  D_LAST="$(last_report '^[0-9][0-9][0-9][0-9]-W[0-9][0-9]\.md$')"
  D_SHA="$(report_sha "$D_LAST")"
  D_CLOSES="$(closes_since "$D_SHA" $(( $(now_epoch) - 604800 )) | wc -l | tr -d ' ')"
  D_SINCE="in the last 7 days"
  [ -n "$D_LAST" ] && D_SINCE="since reports/$D_LAST"
  D_DUE=0
  if [ -z "$D_WK" ]; then
    # No portable date here. Report the fact, refuse the verdict.
    echo "  report      : newest is ${D_LAST:-none} — this box cannot compute the ISO week"
  elif [ -f "$REPORTS/$D_WK.md" ]; then
    echo "  report      : reports/$D_WK.md"
  elif [ "$D_CLOSES" -eq 0 ]; then
    echo "  report      : none due — nothing closed a ticket $D_SINCE"
  else
    echo "  report      : none for $D_WK — $D_CLOSES commit(s) closed a ticket $D_SINCE"
    D_DUE=1
  fi

  if [ "$D_D" -gt 0 ] || [ -n "$D_M" ]; then
    echo "  → the Now column is not the Backlog: navigator syncs docs/00_roadmap/roadmap.md"
  fi
  [ "$D_DUE" -eq 1 ] && echo "  → a week has landed work and no report: scripts/crew report --write"
  return 0
}

# ---------------------------------------------------------------- crew status
cmd_status() {
  require_on
  CAP="$(cfg reader_cap 4)"
  BUDGET_MIN="$(cfg wait_budget_min 30)"
  TODAY="$(date '+%Y-%m-%d')"

  echo "crew status — $REPO"
  echo ""
  main_tree_block
  echo ""
  # Executor state is DERIVED, never stored: idle is a detached HEAD over a clean
  # tree, and a held branch is `processing` until its own commit declares the work
  # done AND the tree owns nothing uncommitted. Only the states something ACTS on
  # are named — `finishing` earns its word because the origin repo measured
  # finished work sitting unmerged for 7h18 with no board saying so (EXECUTION §6),
  # `finished` because a landed ticket otherwise read as one still waiting for its
  # merge, `unclean` because such a tree silently leaves the pool, while a "just
  # assigned, not started yet" state would only be a window nobody reacts to.
  # A parked tree reads `idle` on this board while its session is titled
  # `finished`, and that is not a contradiction: the row is about the tree, which
  # is free, and the title is about the session, which still has a human in it.
  DEVB="$(cfg dev_branch main)"
  echo "executors:"
  # main is a slot like any other: it is where every fast-pair ticket runs
  # (EXECUTION §2). exec_map cannot see it — that matches `<repo>-e<k>` — so the
  # row is built from the ticket side instead. The branch column stays the
  # BRANCH — the one HEAD is really on, read through main_branch() so it can
  # never disagree with the block above — and the fact that it is not
  # `work/b<nnn>` is itself what says fast-pair, so the level needs no column.
  # The dirty count is PLAIN porcelain, the same number the main tree block
  # reports: one tree must not carry two different dirty counts on one board.
  MPD="$(git -C "$MAIN" status --porcelain 2>/dev/null | grep -c .)" || MPD=0
  MPB="$(main_branch)"
  MPT="$(pair_tickets)"
  if [ -z "$MPT" ]; then
    echo "  main  idle"
  else
    echo "$MPT" | while IFS= read -r PT; do
      [ -n "$PT" ] || continue
      PTF="$(ticket_file "$PT")"
      PTS="(no ticket)"
      [ -n "$PTF" ] && PTS="$(front "$PTF" status)"
      echo "  main  $MPB  BACKLOG-$PT  $(pair_state "$PT")  dirty=$MPD  ticket=$PTS"
    done
    MPN="$(echo "$MPT" | grep -c .)" || MPN=0
    [ "$MPN" -gt 1 ] \
      && echo "  ← two fast-pair tickets are open at once; each is meant to be committed in the same bout (EXECUTION §2)"
  fi
  exec_map | while IFS="$(printf '\t')" read -r P B; do
    if [ "$B" = "-" ]; then
      DIRTYC="$(own_dirty "$P")"
      if [ "$DIRTYC" -gt 0 ]; then
        # `unclean` earns a word by the same rule the other three do: something
        # ACTS on it. This tree is out of the pool until someone clears it, and
        # without the word `crew new` would just keep growing the pool with no
        # reason visible on the board.
        echo "  $(en "$P")  unclean  dirty=$DIRTYC  ← holds no ticket but owns uncommitted files; clear it or it never takes another"
      else
        echo "  $(en "$P")  idle"
      fi
    else
      NUM="${B##*/b}"
      DIRTYC="$(own_dirty "$P")"
      STATE="$(exec_state "$P" "$B")"
      TF="$(ticket_file "$NUM")"
      TSTAT="(no ticket)"
      [ -n "$TF" ] && TSTAT="$(front "$TF" status)"
      FLAG=""
      [ -z "$TF" ] && FLAG="  ← orphan: branch without a Backlog item"
      [ "$TSTAT" = "done" ] && FLAG="  ← orphan: ticket is done but the executor still holds the branch"
      BPS="$(bypass_shas "$NUM")"
      echo "  $(en "$P")  $B  BACKLOG-$NUM  $STATE  dirty=$DIRTYC  ticket=$TSTAT${BPS:+  bypass=$BPS}$FLAG"
    fi
  done
  POOL="$(exec_map | wc -l | tr -d ' ')"
  # "pool empty" is about the e-slots, but printed while main holds a ticket it
  # reads as "nothing is running" — the sentence this release exists to stop.
  [ "$POOL" -eq 0 ] && [ -z "$MPT" ] && echo "  (pool empty — scripts/crew executor add)"
  OPEN="$(exec_map | awk -F'\t' '$2 != "-"' | wc -l | tr -d ' ')"
  # A tree left over from the per-ticket model is invisible to everything above,
  # so name it here rather than let it rot unseen.
  git -C "$MAIN" worktree list --porcelain \
    | awk '/^worktree /{n=substr($0,10); sub(".*/","",n); if (n ~ /-b[0-9]+$/) print "  note: " n " is a pre-pool worktree — land it, then git worktree remove it"}'

  # Chains — what is queued behind each session, which no row above can say: a
  # row is one tree and one ticket. The holders are read from the same two places
  # the rows are (the branch each executor has out, and main's fast-pair tickets),
  # so the block cannot name a different holder than the row for that tree.
  # Printed only while some chain still has a ticket not done; a repo that never
  # chained anything sees no new line at all.
  CHB="$(chain_awk board "$(chain_holders)")"
  if [ -n "$CHB" ]; then
    echo ""
    echo "chains:"
    printf '%s\n' "$CHB"
  fi

  echo ""
  echo "locks:"
  FOUND=0
  if [ -d "$STATE/locks" ]; then
    for LF in "$STATE"/locks/*.lock; do
      [ -f "$LF" ] || continue
      FOUND=1
      SINCE=$(( $(date +%s) - $(sed -n 2p "$LF") ))
      echo "  $(basename "$LF" .lock)  held by $(sed -n 1p "$LF")  for ${SINCE}s"
    done
  fi
  [ "$FOUND" -eq 0 ] && echo "  (none held)"

  # In-progress tickets that have no tree — the inverse orphan.
  if [ -d "$MAIN/docs/23_backlog" ]; then
    grep -rlE "^status:[[:space:]]*\"?in-progress\"?" "$MAIN/docs/23_backlog" 2>/dev/null | while read -r TF; do
      TID="$(front "$TF" id)"
      NUM="${TID#BACKLOG-}"
      # A fast-pair ticket has no work branch to hold, so this lookup was always
      # going to miss it — and the note then raised an alarm about the one state
      # the design wants. main's own row above already reports it.
      [ "$(front "$TF" execution)" = "fast-pair" ] && continue
      [ -n "$(exec_on "work/b$NUM")" ] || echo "  note: $TID is in-progress but no executor holds it"
    done
  fi

  # Role/branch readiness — a configured branch that does not exist, or a role
  # declared absent at init, is a gap this board should show, not one a session
  # discovers mid-release.
  PRODB="$(cfg prod_branch production)"
  git -C "$MAIN" show-ref --verify --quiet "refs/heads/$DEVB" \
    || echo "  note: dev_branch '$DEVB' does not exist in this repo"
  git -C "$MAIN" show-ref --verify --quiet "refs/heads/$PRODB" \
    || echo "  note: prod_branch '$PRODB' does not exist — the devops/release half is not wired yet"
  for r in $(cfg roles_absent ""); do
    echo "  note: role '$r' declared absent at init — its duties fall to whoever is around (.claude/crew/roles.md)"
  done

  # Direction — the plan against the work (EXECUTION §3, the navigator hat).
  # Skipped entirely when the hat was declared absent: the note just above is
  # then the whole trace, and nagging for a report nobody wears the hat for is
  # the noise that gets a board switched off.
  case " $(cfg roles_absent "") " in
    *" navigator "*) ;;
    *) direction_block ;;
  esac

  # Pacing — three signals, not a formula (EXECUTION §5).
  WAITSEC=0
  if [ -f "$STATE/log.tsv" ]; then
    WAITSEC="$(awk -F'\t' -v d="$TODAY" 'index($1,d)==1 && $2=="ACQUIRE" {s+=$5} END {print s+0}' "$STATE/log.tsv")"
  fi
  BUDGET=$(( BUDGET_MIN * 60 ))
  echo ""
  echo "pacing:"
  echo "  lock wait today : ${WAITSEC}s (budget ${BUDGET}s)"
  echo "  executors busy  : $OPEN of $POOL (reader ceiling $CAP)"
  if [ "$OPEN" -gt "$CAP" ]; then
    echo "  → past the reader's ceiling: take nothing more, even light tickets"
  elif [ "$POOL" -gt 0 ] && [ "$OPEN" -ge "$POOL" ]; then
    echo "  → every executor is busy: the next ticket grows the pool, so land one or expect e$((POOL + 1))"
  elif [ "$WAITSEC" -gt "$BUDGET" ]; then
    echo "  → the lock is the bottleneck: drop one heavy session"
  elif [ "$WAITSEC" -eq 0 ]; then
    echo "  → rig idle: taking another heavy ticket is fine"
  else
    echo "  → within budget: keep the current mix"
  fi
}

# ---------------------------------------------------------------- crew report
# crew report [<period>] [--write] — the measured half of the navigator's weekly
# or monthly report.
#
# WHY A COMMAND AND NOT A PARAGRAPH IN THE ROLE FILE: the same reason `crew done`
# is a command (§6). A report re-typed from memory keeps the story and loses the
# numbers, and the numbers are the only part that can contradict the story. So
# the machine measures and the hat judges — this prints, and `--write` lays down
# a file whose top half is already filled and whose bottom half is blank.
#
# It never writes prose about the project: the skeleton's judgment sections ship
# empty on purpose. And it refuses to touch an existing report, because a report
# in `92_audit/` is append-only — corrections are a new section at the end, and
# the validator's [audit-append] check enforces that against git HEAD.
report_header() {
  cat <<'SKELH'

> Tệp này nằm trong `docs/92_audit/`, tức tầng Review: nó quan sát Layer 1–2 và
> **chỉ được nối thêm**. Sửa một dòng đã commit ở đây làm `docs-check` đỏ ở phép
> kiểm `[audit-append]`. Cần đính chính thì nối thêm mục `## Đính chính` ở cuối
> chứ đừng viết đè lên dòng cũ.
SKELH
}

# report_body <week|month> — the judgment half, shipped empty on purpose. The
# section numbers differ between the two kinds because the month carries one
# extra pair (last month's plan, this month's order), and a report whose numbers
# skip is a report somebody will assume lost a section.
report_body() {
  cat <<'SKELB'

## 2. Việc đã hạ cánh

- _Mỗi phiếu một dòng: id, nó đổi được gì, và điều bất ngờ nếu có._

## 3. Lệch so với lộ trình

- _Phiếu nào chạy ngoài cột `## Now`, và phiếu nào nằm trong `## Now` mà tuần
  này không ai động tới. Mục 1 nói CÓ lệch hay không; mục này nói vì sao._
SKELB
  if [ "$1" = month ]; then
    cat <<'SKELM'

## 4. Kế hoạch tháng trước, đối chiếu

- _Từng dòng đã xếp cho tháng trước: xong, trượt, hay bỏ — kèm lý do nếu trượt._

## 5. Thứ tự tháng này

- _Mỗi dòng một id và tuần dự kiến. Không dài hơn số phiếu tháng trước đã hạ
  cánh cộng một, vì một danh sách dài hơn sức làm thì tháng sau không đối chiếu
  được với cái gì._

## 6. Cần chủ dự án quyết

- _Câu hỏi kèm phương án và cái giá của từng phương án. Không có thì ghi thẳng
  "không có"._

## 7. Đổi hướng thì đi đường nào

- _Đồng bộ cột `## Now` chỉ cần một dòng audit. Còn chuyển một dòng sang
  `## Explicitly not doing`, hay bỏ một hướng đang làm, là kết thúc một cuộc
  bàn: đi qua Proposal → Decision rồi mới sửa roadmap._
SKELM
  else
    cat <<'SKELW'

## 4. Kế hoạch tuần tới

- _Mỗi dòng một id đã có, hoặc một Issue để planner cắt phiếu. Không xếp nhiều
  hơn số phiếu tuần này đã hạ cánh cộng một._

## 5. Cần chủ dự án quyết

- _Câu hỏi kèm phương án và cái giá của từng phương án. Không có thì ghi thẳng
  "không có"._

## 6. Đổi hướng thì đi đường nào

- _Đồng bộ cột `## Now` chỉ cần một dòng audit. Còn chuyển một dòng sang
  `## Explicitly not doing`, hay bỏ một hướng đang làm, là kết thúc một cuộc
  bàn: đi qua Proposal → Decision rồi mới sửa roadmap._
SKELW
  fi
}

cmd_report() {
  require_on
  PERIOD=""
  WRITE=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --write) WRITE=1 ;;
      -*) die "unknown flag: $1 (usage: crew report [<period>] [--write])" ;;
      *) PERIOD="$1" ;;
    esac
    shift
  done
  NOWE="$(now_epoch)"
  [ -n "$PERIOD" ] || PERIOD="$(tok "$NOWE" %G-W%V)"
  [ -n "$PERIOD" ] \
    || die "cannot compute the ISO week on this box — name the period: scripts/crew report 2026-W37"
  case "$PERIOD" in
    [0-9][0-9][0-9][0-9]-W[0-9][0-9]) KIND=week;  GRAM='^[0-9][0-9][0-9][0-9]-W[0-9][0-9]\.md$' ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9])  KIND=month; GRAM='^[0-9][0-9][0-9][0-9]-[0-9][0-9]\.md$' ;;
    *) die "a period is a week (2026-W37) or a month (2026-09), not '$PERIOD'" ;;
  esac
  TARGET="$REPORTS/$PERIOD.md"
  if [ "$WRITE" -eq 1 ] && [ -e "$TARGET" ]; then
    die "[report:exists] docs/92_audit/reports/$PERIOD.md already exists — a report is append-only, so add a '## Đính chính' section to it by hand instead of rewriting it"
  fi

  # The window is the previous report's COMMIT, not a calendar subtraction: a
  # report written late still closes its window exactly where the last one ended,
  # so no commit is counted twice and none falls between two reports.
  LAST="$(last_report "$GRAM" | grep -v "^$PERIOD\.md$" || true)"
  SHA="$(report_sha "$LAST")"
  BACK=604800
  [ "$KIND" = month ] && BACK=2592000
  if [ -n "$SHA" ]; then
    WINDOW="$(git -C "$MAIN" rev-parse --short "$SHA" 2>/dev/null)..HEAD (since reports/$LAST)"
    FROMD="$(git -C "$MAIN" log -1 --format=%cs "$SHA" 2>/dev/null)"
  else
    WINDOW="the last $((BACK / 86400)) days (no earlier report to close a window)"
    FROMD="$(tok $(( NOWE - BACK )) %Y-%m-%d)"
  fi

  SHAS="$(closes_since "$SHA" $(( NOWE - BACK )))"
  NCLOSE="$(printf '%s' "$SHAS" | grep -c . || true)"
  CIDS=""
  if [ -n "$SHAS" ]; then
    CIDS="$(printf '%s\n' "$SHAS" | while read -r s; do
      git -C "$MAIN" log -1 --format=%B "$s" 2>/dev/null | grep -oE 'Closes:[[:space:]]*BACKLOG-[0-9]+'
    done | grep -oE 'BACKLOG-[0-9]+' | LC_ALL=C sort -u | tr '\n' ' ')"
  fi
  NIDCOUNT=0
  [ -n "$CIDS" ] && NIDCOUNT="$(printf '%s' "$CIDS" | wc -w | tr -d ' ')"

  AUDIT="- (no earlier report to diff a window against)"
  if [ -n "$SHA" ]; then
    AUDIT="$(git -C "$MAIN" diff "$SHA..HEAD" -- docs/92_audit/LOG.md 2>/dev/null \
      | grep -c '^+.*BACKLOG-' || true) appended to LOG.md citing a Backlog id"
  fi

  DONEC=0; SIZEBAD=0; SIZEN=0; WAIT=0
  if [ -f "$STATE/log.tsv" ] && [ -n "$FROMD" ]; then
    DONEC="$(awk -F'\t' -v d="$FROMD" '$1 >= d && $2=="DONE"' "$STATE/log.tsv" | grep -c . || true)"
    SIZEN="$(awk -F'\t' -v d="$FROMD" '$1 >= d && $2=="SIZE"' "$STATE/log.tsv" | grep -c . || true)"
    SIZEBAD="$(awk -F'\t' -v d="$FROMD" '$1 >= d && $2=="SIZE" {
        split($5, a, " "); split(a[1], dd, "="); split(a[2], aa, "=");
        if (dd[2] != aa[2]) n++
      } END {print n+0}' "$STATE/log.tsv")"
    WAIT="$(awk -F'\t' -v d="$FROMD" '$1 >= d && $2=="ACQUIRE" {s+=$5} END {print s+0}' "$STATE/log.tsv")"
  fi

  R_STATS="$(roadmap_stats)"
  R_L="$(printf '%s' "$R_STATS" | cut -f1)"
  R_D="$(printf '%s' "$R_STATS" | cut -f2)"
  R_O="$(printf '%s' "$R_STATS" | cut -f3)"
  R_P="$(printf '%s' "$R_STATS" | cut -f4)"
  R_M="$(printf '%s' "$R_STATS" | cut -f5)"

  OFF=""
  if [ -f "$ROADMAP" ]; then
    for i in $(open_ids); do
      grep -q "$i" "$ROADMAP" || OFF="${OFF:+$OFF }$i"
    done
    NOID="$(awk '/^## Next|^## Later/{f=1;next} /^## /{f=0} f && /^- /' "$ROADMAP" \
      | grep -v '^- _' | grep -cvE 'ISSUE-[0-9]+|DECISION-[0-9]+|BACKLOG-[0-9]+' || true)"
  else
    NOID="-"
  fi
  OFFC=0
  [ -n "$OFF" ] && OFFC="$(printf '%s' "$OFF" | wc -w | tr -d ' ')"

  MEASURED="$(cat <<MEAS
period      : $PERIOD ($KIND)
window      : $WINDOW
landed      : $NIDCOUNT ticket(s) in $NCLOSE commit(s)${CIDS:+ — ${CIDS% }}
audit lines : $AUDIT
crew done   : $DONEC in ../$(basename "$STATE")/log.tsv
size calls  : $SIZEBAD of $SIZEN with declared != actual
lock wait   : ${WAIT}s in the window (approximate — log.tsv stamps local time)
roadmap Now : $R_L listed · $R_D done · $R_P of $R_O open present${R_M:+
not listed  : $R_M}
off-roadmap : $OFFC open ticket(s) named in no column${OFF:+ — $OFF}
no-id lines : $NOID bullet(s) under Next/Later carrying no ISSUE or DECISION id
MEAS
)"

  if [ "$WRITE" -eq 0 ]; then
    echo "$MEASURED"
    echo ""
    if [ -e "$TARGET" ]; then
      echo "report      : docs/92_audit/reports/$PERIOD.md exists — append to it, never rewrite"
    else
      echo "report      : docs/92_audit/reports/$PERIOD.md not written — pass --write"
    fi
    return 0
  fi

  mkdir -p "$REPORTS"
  TITLE="Báo cáo tuần"
  [ "$KIND" = month ] && TITLE="Kế hoạch tháng"
  {
    echo "# $TITLE $PERIOD — $REPO"
    report_header
    echo ""
    echo "## 1. Số đo"
    echo ""
    echo '```'
    echo "$MEASURED"
    echo '```'
    echo ""
    echo "Nửa trên do \`scripts/crew report\` đo từ git và \`docs/\`. Mọi mục dưới đây"
    echo "là phán đoán và phải do navigator viết — lệnh cố ý không viết hộ."
    report_body "$KIND"
  } > "$TARGET"
  note "wrote docs/92_audit/reports/$PERIOD.md — the measured half is filled, the judgment half is yours"
  note "then: sync docs/00_roadmap/roadmap.md and append one line to docs/92_audit/LOG.md"
  note "the audit line's ref column names the report FILE, never an open ticket id"
  note "(docs_close reads every *.md directly under 92_audit/ and treats a mentioned"
  note " id as already recorded — that is why reports live in reports/ and cite paths)"
}

# ---------------------------------------------------------------- role
# crew role <role> — print the role file, resolved from the MAIN tree.
#
# WHY THIS EXISTS: a session opened from a task cannot INVOKE a role file — they
# all carry disable-model-invocation, on purpose — but it can read one. Telling
# it to read `.claude/commands/executor.md` assumes two things that are not true
# everywhere: that the session sits in the main tree (it moves to a worktree at
# `crew new`), and that `.claude/` is tracked by git (a repo is free to ignore
# it, and then the worktree has no copy at all). This reads from $MAIN, which is
# computed from git, so neither assumption is needed.
cmd_role() {
  RN="${1:-}"
  [ -n "$RN" ] || die "usage: crew role <role>"
  RF="$MAIN/.claude/commands/$RN.md"
  [ -f "$RF" ] || die "no role file for '$RN' at $RF — crew-init may have left the role unstamped (.claude/crew/roles.md)"
  cat "$RF"
}

# ---------------------------------------------------------------- name
# crew name <role> [<nnn>] — is this session wearing its hat's name?
#
# WHY THIS IS A COMMAND AND NOT A SENTENCE IN THE ROLE FILE: the session list is
# the only place a human sees which hats are on, and a hat nobody can see is a
# hat that gets worn twice.
#
# WHY IT READS THE TITLE AND NOT THE CLI's SESSION `name` — measured, 0.26.3:
# they are two fields set by two different gestures. Renaming inside the desktop
# app writes the TITLE only; `/rename` in a terminal writes both. The first
# version of this check read `name`, and four sessions renamed in the app — each
# correctly named and plainly readable in the sidebar — all came back red. A
# check that fails on the exact gesture it is asking for is a check that gets
# switched off.
#
# The title is a fact on disk: the last {"type":"custom-title"} record in the
# session transcript, reached from the sessionId in the live session entry.
#
# WHAT THIS DOES NOT DO: titles are not unique, so nothing here stops two
# sessions wearing one hat. It makes the hat visible; the human reading the list
# is what catches the duplicate.
#
# Fail open whenever a piece cannot be read — no session entry, no transcript,
# no python3 — because a role must not become unrunnable when the checker goes
# blind. A title that IS readable and wrong exits 1: that is the whole point.
SESSIONS="${CREW_SESSIONS_DIR:-$HOME/.claude/sessions}"
PROJECTS="${CREW_PROJECTS_DIR:-$HOME/.claude/projects}"

session_file() {
  SP=$$
  SI=0
  while [ "$SI" -lt 12 ]; do
    [ -f "$SESSIONS/$SP.json" ] && { echo "$SESSIONS/$SP.json"; return 0; }
    SP="$(ps -o ppid= -p "$SP" 2>/dev/null | tr -d ' ')"
    [ -n "$SP" ] && [ "$SP" != "0" ] && [ "$SP" != "1" ] || return 1
    SI=$((SI + 1))
  done
  return 1
}

cmd_name() {
  ROLE="${1:-}"
  [ -n "$ROLE" ] || die "usage: crew name <role> [<nnn>|<subject>] [--want|--group]"
  # --want prints the computed title and nothing else. It exists so the Stop hook
  # can compare a session's title against the truth WITHOUT re-deriving the
  # grammar: three parts read from git, one place, and nothing else spelling them
  # out again. Everything below is unchanged for a call without the flag.
  #
  # --group prints the desktop sidebar groups this session belongs in, best first:
  # the subject's group, then the project's. The kit cannot touch the sidebar —
  # only the model in the app can — so this is the one fact it hands over, and the
  # role file says what to do with it (EXECUTION §3).
  WANTONLY=0
  GROUPONLY=0
  TICKET=""
  SUBJ=""
  shift
  for a in "$@"; do
    case "$a" in
      --want)  WANTONLY=1 ;;
      --group) GROUPONLY=1 ;;
      *) if SA="$(subj_id "$a")"; then SUBJ="$SA"; else TICKET="$a"; fi ;;
    esac
  done
  [ "$ROLE" = "executor" ] && [ -n "$SUBJ" ] \
    && die "an executor is named by its ticket; its subject is read from the ticket's source_ref"
  # One grammar, one place: project, then role, then the task — `<repo> · <role>
  # [· <task>]`. The fixed part leads and the optional part trails, so a hat with
  # no task is the head of the same title with one. The user chose that order on
  # 2026-09-24 and dropped the old `crew/` prefix to buy the width back.
  # A session carries ONE CHAIN — a ticket nobody chained is a chain of one — and
  # its title always names exactly one ticket, the one its tree holds now, so an
  # executor session is born processing and ends finished, and there is
  # deliberately no idle form: an idle executor has no session to name. The parts
  # are read from git and the tickets rather than typed (branch → b<nnn>,
  # source_ref → subject, after_ref → first→last, tree → e<k>, trailer → state),
  # so the cwd beats any ticket argument. A hat takes a ticket (`b157`) or a
  # subject (`d009 <slug>`) when it is working one. Never let a role file spell
  # any of these out again.
  HERE="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  SUF=""
  TN=""
  case "$(basename "${HERE:-.}")" in "$REPO"-e[0-9]*) SUF="$(en "$HERE")" ;; esac
  if [ "$ROLE" = "executor" ] && [ -n "$SUF" ]; then
    HB="$(git -C "$HERE" symbolic-ref --short HEAD 2>/dev/null || true)"
    case "$HB" in
      work/b*) TN="${HB#work/b}"; WANT="$(exec_title "$TN" "$SUF" "$(exec_state "$HERE" "$HB")")" ;;
      *)
        # A PARKED executor holds no branch, so the branch can no longer name the
        # ticket — but the session is still open, and its work has landed. This is
        # the one place the ticket argument beats the cwd, and it is deliberately
        # narrow: only a ticket whose closer is on the dev branch AND whose doc
        # reads `status: done` is named here, so a tree that is merely free still
        # refuses. Measured 2026-09-12, before this branch existed: `crew done`
        # parked the tree, this command exited 1, and the Stop hook — which is
        # silent on any non-zero exit — left the session sitting at `finishing`
        # for the rest of its life.
        PKN=""
        [ -n "$TICKET" ] && PKN="$(norm "$TICKET")"
        if [ -n "$PKN" ] && has_closer "$MAIN" "$PKN" -50 "$(cfg dev_branch main)"; then
          if ticket_done "$PKN"; then
            TN="$PKN"; WANT="$(exec_title "$PKN" "$SUF" "$(closed_state "$PKN")")"
          else
            # Merged, parked, never closed out. There IS no title for this: the
            # session's own `finishing` is still the honest word, because a
            # close-out is missing and somebody has to write it. Say which half
            # is missing instead of repeating the take-a-ticket line.
            note "[name:unclosed] BACKLOG-$PKN is merged but its doc is not closed out"
            die "close it out first — /docs-kit:docs-sync, or docs_close.sh --apply (STANDARD §6.1); this session stays $(closed_state "$PKN") until then"
          fi
        else
          die "$SUF holds no ticket, so there is no executor session to name — take one first: scripts/crew new <nnn>"
        fi
        ;;
    esac
  elif [ "$ROLE" = "executor" ]; then
    # Main tree: this is a fast-pair session (EXECUTION §2). It gets a session
    # like any other ticket — only the worktree and the branch are skipped — so
    # it reads in the same shape, with `main` as the place. The ticket cannot be
    # derived here (there is no work branch), so it must be passed.
    [ -n "$TICKET" ] \
      || die "an executor session belongs to one ticket — pass its number: scripts/crew name executor <nnn>"
    PN="$(norm "$TICKET")"
    # The comment above ASSUMED fast-pair; this checks it. The three parts of a
    # title are read from git, which answers "which tree am I in" and never
    # "which tree should this ticket be in". Measured before this guard: from the
    # main tree, a `full` ticket was blessed as `<repo> · main · b077 ·
    # processing` (the pre-0.42 grammar), so a session that skipped `crew new` was told
    # its title was correct and went on to edit the shared tree — where check 2
    # then refuses every crew done in flight. Fail open on a missing field:
    # `execution:` is optional (EXECUTION §3) and the kit does not guess a level
    # nobody recorded.
    NTF="$(ticket_file "$PN")"
    NLVL=""
    [ -n "$NTF" ] && NLVL="$(front "$NTF" execution)"
    case "$NLVL" in
      fast|full)
        note "[name:place] BACKLOG-$PN is $NLVL: it belongs in an executor worktree, not the main tree"
        die "take one first: scripts/crew new $PN — then name this session from the tree that prints"
        ;;
    esac
    TN="$PN"; WANT="$(exec_title "$PN" main "$(pair_state "$PN")")"
  elif [ -n "$SUBJ" ]; then
    # A subject planner is named by the document it drives, so the list says what
    # it is working on, and the executors serving that document carry the same
    # token. Refuse an id with no document behind it: the words come from its
    # file name, and a subject nobody wrote down is not one.
    SL="$(subj_label "$SUBJ")" \
      || die "[name:subject] no document with id $SUBJ under docs/ — a subject is a document that exists"
    WANT="$REPO · $ROLE · $SL"
  elif [ -n "$TICKET" ]; then
    WANT="$REPO · $ROLE · b$(norm "$TICKET")"
  else
    WANT="$REPO · $ROLE"
  fi

  [ "$WANTONLY" = "1" ] && { printf '%s\n' "$WANT"; return 0; }
  if [ "$GROUPONLY" = "1" ]; then
    [ -n "$TN" ] && SUBJ="$(ticket_subject "$TN")"
    [ -n "$SUBJ" ] && GL="$(subj_label "$SUBJ")" && printf '%s · %s\n' "$REPO" "$GL"
    printf '%s\n' "$REPO"
    return 0
  fi

  skip() { note "name: $1 — check skipped"; note "name: this session should be titled: $WANT"; }

  SF="$(session_file)" || { skip "no session entry under $SESSIONS"; return 0; }
  command -v python3 >/dev/null 2>&1 || { skip "python3 missing"; return 0; }

  GOT="$(python3 - "$SF" "$PROJECTS" <<'PYNAME'
import glob, json, os, sys
try:
    sid = (json.load(open(sys.argv[1])) or {}).get("sessionId") or ""
except Exception:
    sid = ""
if not sid:
    raise SystemExit(2)
found = glob.glob(os.path.join(sys.argv[2], "*", sid + ".jsonl"))
if not found:
    raise SystemExit(2)
title = ""
with open(found[0], errors="replace") as f:
    for line in f:
        if '"custom-title"' not in line:
            continue
        try:
            rec = json.loads(line)
        except Exception:
            continue
        if rec.get("type") == "custom-title" and rec.get("customTitle"):
            title = rec["customTitle"]
print(title)
PYNAME
)" || { skip "no transcript for this session under $PROJECTS"; return 0; }

  if [ "$GOT" = "$WANT" ]; then
    note "name ok: $GOT"
    return 0
  fi
  if [ -z "$GOT" ]; then
    echo "crew: [name:wrong] this session has no set title, so the list shows an" >&2
    echo "crew: auto-generated one; the $ROLE hat is '$WANT'" >&2
  else
    echo "crew: [name:wrong] this session is titled '$GOT'; the $ROLE hat is '$WANT'" >&2
  fi
  echo "crew: retitle it, then run the check again — inside the app the session" >&2
  echo "crew: can retitle itself; in a terminal the human types:" >&2
  echo "" >&2
  echo "  /rename $WANT" >&2
  exit 1
}

# ---------------------------------------------------------------- dispatch
case "${1:-help}" in
  new)    shift; cmd_new "$@" ;;
  done)   shift; cmd_done "$@" ;;
  executor) shift; cmd_executor "$@" ;;
  lock)   shift; cmd_lock "$@" ;;
  status) shift; cmd_status "$@" ;;
  report) shift; cmd_report "$@" ;;
  name)   shift; cmd_name "$@" ;;
  role)   shift; cmd_role "$@" ;;
  help|--help|-h)
    awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"
    ;;
  *) die "unknown subcommand: $1 (try: crew help)" ;;
esac
